[Unit]
Description=The Tailscale network's devices in Files, ~/Tailscale (live-tailnet)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/live-tailnet
# Killed before it could unmount: the next start clears the mount too
ExecStopPost=-/usr/bin/fusermount3 -u -z %h/Tailscale
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
