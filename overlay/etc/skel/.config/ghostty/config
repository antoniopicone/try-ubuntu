# Ghostty's settings for new users (see `ghostty +show-config --default --docs`).
# The interface follows the session's language: no `language` here.
font-family = Hack Nerd Font Mono
font-size = 11
window-padding-x = 10
theme = Catppuccin Mocha
shell-integration-features = no-cursor
cursor-style = underline
bell-features = no-audio
term = xterm-256color
