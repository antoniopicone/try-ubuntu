#!/bin/sh
# install-packages PACKAGE...: installs the apt packages a restored backup
# had (apps.py, through pkexec: it asks for the user's password). The
# package lists are refreshed first (the live image ships without them);
# those the archive doesn't have are skipped. The last line of the output
# is JSON: {"missing": [the packages not installed]}.
set -u

[ "$(id -u)" = 0 ] || { echo "must run as root (pkexec)" >&2; exit 1; }
for p; do
  case "$p" in
    *[!a-z0-9+.-]*|[!a-z0-9]*) echo "invalid package name: $p" >&2; exit 64 ;;
  esac
done

export DEBIAN_FRONTEND=noninteractive
apt-get update -q >&2 || true
available="" missing=""
for p; do
  if apt-cache show "$p" >/dev/null 2>&1; then
    available="$available $p"
  else
    missing="$missing $p"
  fi
done
# shellcheck disable=SC2086 # one word each: the names are checked above
if [ -n "$available" ] && ! apt-get install -y -q $available >&2; then
  missing="$missing $available"
fi
printf '{"missing": ['
sep=""
for p in $missing; do printf '%s"%s"' "$sep" "$p"; sep=", "; done
printf ']}\n'
