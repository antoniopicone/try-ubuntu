#!/usr/bin/python3
"""setup-user: creates the first real user from the welcome app's choices.

Run as root through pkexec (org.ubuntu.live-welcome.setup-user), with the
choices as JSON on stdin:

  {"fullname": "...", "username": "...", "password": "...", "email": "...",
   "hostname": "ubuntu-laptop-anna",
   "locale": "it_IT.UTF-8", "layout": "it" | "us:intl",
   "color_scheme": "default" | "prefer-dark", "accent": "blue" | ...,
   "avatar": "<base64 PNG>" | ""}

It works once: afterwards (/var/lib/live-welcome/done) it refuses to run, so
the polkit rule that lets the live session call it without a password can't
be used to create more users. Besides the user it sets:
  - the system language and keyboard layout (GDM's too)
  - the user's GNOME settings (style, accent, Yaru variant, input source,
    region) in their dconf database, so the first login is already themed
  - git's user.name / user.email
  - Cloud Config at the first login (live-cloud-config --first-run: the
    network, Tailscale, the clouds; it removes itself from autostart and
    opens Cloud Backup, live-backup --first-run, for the backups, which
    then opens the AI app, live-ai --first-run)
  - the user's picture (the avatar, when there is one), for GDM and GNOME
and it takes the live user's admin rights away at once, turns GDM's
autologin off and has live-retire-user.service delete the live user (with
its home) as soon as its session logs out.
"""
import base64
import binascii
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

DONE = "/var/lib/live-welcome/done"
RETIRE = "/var/lib/live-welcome/retire"
SNAPPER_CONFIGS = ("/etc/snapper/configs/root", "/etc/snapper/configs/home")
GDM_CONF = "/etc/gdm3/custom.conf"
ACCOUNTS = "/var/lib/AccountsService/users"
ICONS = "/var/lib/AccountsService/icons"
AVATAR_MAX = 2 * 1024 * 1024
LOCALES = {"en_US.UTF-8", "it_IT.UTF-8", "es_ES.UTF-8", "fr_FR.UTF-8",
           "de_DE.UTF-8", "pt_BR.UTF-8"}
ACCENTS = {"blue", "teal", "green", "yellow", "orange", "red", "pink",
           "purple", "slate"}
# Ubuntu's accent -> Yaru variant map (see /usr/local/bin/yaru-accent-sync).
YARU = {"blue": "blue", "teal": "prussiangreen", "green": "olive",
        "yellow": "yellow", "orange": "", "red": "red", "pink": "magenta",
        "purple": "purple", "slate": "sage"}
# adm: the system journal, as for Ubuntu's first user (coredumpctl and the
# crash notifications read systemd-coredump's entries there)
GROUPS = ["sudo", "adm", "video", "render", "input"]


def fail(message):
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(1)


def run(*cmd, stdin=None):
    result = subprocess.run(cmd, input=stdin, text=True, capture_output=True)
    if result.returncode != 0:
        fail(f"{' '.join(cmd[:2])}: {result.stderr.strip() or result.returncode}")
    return result.stdout


def validate(c):
    for key in ("fullname", "username", "password", "email", "hostname", "locale",
                "layout", "color_scheme", "accent"):
        if not isinstance(c.get(key), str):
            fail(f"missing {key}")
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", c["username"]):
        fail("invalid username")
    try:
        pwd.getpwnam(c["username"])
        fail("the username is already taken")
    except KeyError:
        pass
    if not c["fullname"].strip() or re.search(r"[:,\n]", c["fullname"]):
        fail("invalid full name")
    if not c["password"] or "\n" in c["password"]:
        fail("invalid password")
    if c["email"] and not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", c["email"]):
        fail("invalid email")
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", c["hostname"]):
        fail("invalid computer name")
    if c["locale"] not in LOCALES:
        fail("unsupported language")
    if not re.fullmatch(r"[a-z]{2,3}(:[a-z0-9_]+)?", c["layout"]):
        fail("invalid keyboard layout")
    if c["color_scheme"] not in ("default", "prefer-dark") or c["accent"] not in ACCENTS:
        fail("invalid theme")
    if not isinstance(c.get("avatar", ""), str):
        fail("invalid picture")


def avatar(c):
    """The picture as PNG bytes, or None."""
    if not c.get("avatar"):
        return None
    try:
        png = base64.b64decode(c["avatar"], validate=True)
    except (binascii.Error, ValueError):
        fail("invalid picture")
    if not png.startswith(b"\x89PNG\r\n\x1a\n") or len(png) > AVATAR_MAX:
        fail("invalid picture")
    return png


def next_subid(path):
    start = 100000
    try:
        for line in open(path):
            parts = line.strip().split(":")
            if len(parts) == 3:
                start = max(start, int(parts[1]) + int(parts[2]))
    except FileNotFoundError:
        pass
    return start


def set_ini(path, section, values, mode=0o600):
    """Sets keys in an INI-style file (AccountsService, GDM), keeping the rest."""
    lines = open(path).read().splitlines() if os.path.exists(path) else []
    if f"[{section}]" not in lines:
        lines += ["", f"[{section}]"] if lines else [f"[{section}]"]
    start = lines.index(f"[{section}]") + 1
    end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
    body = [l for l in lines[start:end]
            if not any(re.match(rf"#?\s*{re.escape(k)}\s*=", l) for k in values)]
    body = [f"{k}={v}" for k, v in values.items()] + body
    lines[start:end] = body
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(path, mode)


def main():
    if os.geteuid() != 0:
        fail("must run as root (pkexec)")
    if os.path.exists(DONE):
        fail("the first user has already been created")
    c = json.load(sys.stdin)
    validate(c)
    picture = avatar(c)
    user = c["username"]
    live_uid = int(os.environ.get("PKEXEC_UID", "-1"))
    live_user = pwd.getpwuid(live_uid).pw_name if live_uid >= 0 else None

    # The user
    run("useradd", "-m", "-s", "/usr/bin/zsh", "-c", c["fullname"].strip(),
        "-G", ",".join(GROUPS), user)
    run("chpasswd", stdin=f"{user}:{c['password']}\n")
    for path in ("/etc/subuid", "/etc/subgid"):  # rootless podman
        if not any(l.startswith(f"{user}:") for l in open(path)):
            with open(path, "a") as f:
                f.write(f"{user}:{next_subid(path)}:65536\n")
    pw = pwd.getpwnam(user)

    # The computer's name, and the loopback name it resolves to
    run("hostnamectl", "set-hostname", c["hostname"])
    hosts = open("/etc/hosts").read().splitlines() if os.path.exists("/etc/hosts") else []
    hosts = [l for l in hosts if not l.startswith("127.0.1.1")]
    hosts.insert(1 if hosts else 0, f"127.0.1.1\t{c['hostname']}")
    with open("/etc/hosts", "w") as f:
        f.write("\n".join(hosts) + "\n")

    # Language and keyboard, system-wide (GDM, consoles) and for the user
    layout, _, variant = c["layout"].partition(":")
    run("localectl", "set-locale", f"LANG={c['locale']}")
    # The keyboard goes straight into /etc/default/keyboard (what localed,
    # GDM and the consoles read on Ubuntu): localed refuses set-x11-keymap
    # in this image.
    with open("/etc/default/keyboard", "w") as f:
        f.write(f'XKBMODEL="pc105"\nXKBLAYOUT="{layout}"\nXKBVARIANT="{variant}"\n'
                'XKBOPTIONS=""\nBACKSPACE="guess"\n')
    subprocess.run(["systemctl", "try-restart", "systemd-localed.service"])
    os.makedirs(ACCOUNTS, exist_ok=True)
    account = {"Language": c["locale"], "Session": "gnome", "Email": c["email"],
               "SystemAccount": "false"}
    # The picture where GNOME Settings puts it (AccountsService's icons)
    if picture:
        os.makedirs(ICONS, exist_ok=True)
        with open(f"{ICONS}/{user}", "wb") as f:
            f.write(picture)
        os.chmod(f"{ICONS}/{user}", 0o644)
        account["Icon"] = f"{ICONS}/{user}"
    set_ini(f"{ACCOUNTS}/{user}", "User", account)

    # GNOME settings, compiled into the user's dconf database
    yaru = YARU[c["accent"]]
    icon_theme = "Yaru" + (f"-{yaru}" if yaru else "") + \
        ("-dark" if c["color_scheme"] == "prefer-dark" else "")
    source = f"('xkb', '{layout}+{variant}')" if variant else f"('xkb', '{layout}')"
    keyfile = f"""[org/gnome/desktop/interface]
color-scheme='{c['color_scheme']}'
accent-color='{c['accent']}'
icon-theme='{icon_theme}'

[org/gnome/desktop/input-sources]
sources=[{source}]

[org/gnome/system/locale]
region='{c['locale']}'
"""
    dconf_dir = os.path.join(pw.pw_dir, ".config", "dconf")
    os.makedirs(dconf_dir, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        with open(os.path.join(tmp, "00-live-welcome"), "w") as f:
            f.write(keyfile)
        run("dconf", "compile", os.path.join(dconf_dir, "user"), tmp)

    # Cloud Config at the first login: the network, Tailscale, the clouds,
    # then Cloud Backup (where the encrypted backups go)
    autostart = os.path.join(pw.pw_dir, ".config", "autostart")
    os.makedirs(autostart, exist_ok=True)
    with open(os.path.join(autostart, "org.ubuntu.LiveCloudConfig.desktop"), "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=Cloud Config\n"
                "Exec=live-cloud-config --first-run\nIcon=org.ubuntu.LiveCloudConfig\n"
                "X-GNOME-Autostart-Delay=3\nNoDisplay=true\n")

    # git
    if c["email"]:
        with open(os.path.join(pw.pw_dir, ".gitconfig"), "w") as f:
            f.write(f"[user]\n\tname = {c['fullname'].strip()}\n\temail = {c['email']}\n"
                    "[init]\n\tdefaultBranch = main\n")
    # The default apps, the system's (/etc/xdg/mimeapps.list: Brave Origin,
    # Files), set as the user's own too, as GNOME Settings writes them: what
    # Brave checks before asking to become the default browser.
    with open(os.path.join(pw.pw_dir, ".config", "mimeapps.list"), "w") as f:
        f.write(open("/etc/xdg/mimeapps.list").read())
    run("chown", "-R", f"{pw.pw_uid}:{pw.pw_gid}", os.path.join(pw.pw_dir, ".config"))
    if c["email"]:
        os.chown(os.path.join(pw.pw_dir, ".gitconfig"), pw.pw_uid, pw.pw_gid)

    # Snapshots (/ and /home): the new user's, not the live user's. snapperd
    # rereads its configs at start; for /home, SYNC_ACL moves the access to
    # /home/.snapshots over (snapper's set-config does both).
    for path in SNAPPER_CONFIGS:
        if os.path.exists(path):
            subprocess.run(["snapper", "-c", os.path.basename(path), "set-config",
                            f"ALLOW_USERS={user}"], capture_output=True)

    # Retire the live user. Right away: no autologin, hidden from GDM,
    # locked, no admin groups (sudo, polkit), no sudoers file. It can't be
    # deleted while its session runs (this runs in it): live-retire-user
    # does that after the logout, or at the next boot.
    set_ini(GDM_CONF, "daemon", {"AutomaticLoginEnable": "false"}, mode=0o644)
    with open(GDM_CONF) as f:
        gdm = re.sub(r"(?m)^AutomaticLogin=.*\n", "", f.read())
    with open(GDM_CONF, "w") as f:
        f.write(gdm)
    if live_user and live_user != "root":
        set_ini(f"{ACCOUNTS}/{live_user}", "User", {"SystemAccount": "true"})
        run("passwd", "-l", live_user)
        run("usermod", "-G", "", live_user)
        sudoers = "/etc/sudoers.d/live-user"
        if os.path.exists(sudoers):
            os.remove(sudoers)
        os.makedirs(os.path.dirname(RETIRE), exist_ok=True)
        with open(RETIRE, "w") as f:
            f.write(live_user + "\n")
        subprocess.run(["systemctl", "start", "--no-block", "live-retire-user.service"])
    # accounts-daemon reads its files at start: GDM must see the change.
    subprocess.run(["systemctl", "try-restart", "accounts-daemon.service"])

    os.makedirs(os.path.dirname(DONE), exist_ok=True)
    with open(DONE, "w") as f:
        json.dump({"user": user, "date": datetime.now(timezone.utc).isoformat()}, f)
    # The host's shared folder (run-qemu.sh --shared-folder) is the new
    # user's now: live-shared-folder reads who from DONE, so after it
    subprocess.run(["systemctl", "try-restart", "live-shared-folder.service"])
    print(json.dumps({"ok": True, "user": user}))


if __name__ == "__main__":
    main()
