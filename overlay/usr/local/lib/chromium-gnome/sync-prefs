#!/usr/bin/python3
"""sync-prefs: gives Chromium the user's GNOME accent color.

Run by the Chromium launcher (/etc/chromium.d/gnome-accent) before Chromium
starts. Chromium follows GNOME's light/dark style and the language (LANG)
on its own, but on Linux it has no "follow the device's colors": its
palette comes from a color picked in its own "Customize Chromium" panel,
stored in the profile (browser.theme.user_color2). This sets that color to
GNOME's accent (org.gnome.desktop.interface accent-color):

  - no profile yet: creates it from Chromium's initial preferences
    (/etc/chromium/master_preferences) plus the accent, and marks the first
    run as done. Otherwise Chromium's first run would replace the profile
    with the initial preferences, whose color can't be per user.
  - existing profile: sets the color when GNOME's accent changed since the
    last sync (~/.config/chromium/.gnome-accent), so a color picked in
    Chromium stays until the next change in GNOME Settings.

Nothing happens while Chromium runs (it would overwrite the profile when
it exits): the launch then only opens a window in the running browser.
"""
import json
import os
import sys

from gi.repository import Gio

# GNOME's accent colors (libadwaita), as in live-welcome.
ACCENTS = {
    "blue": 0x3584e4, "teal": 0x2190a4, "green": 0x3a944a,
    "yellow": 0xc88800, "orange": 0xed5b00, "red": 0xe62d42,
    "pink": 0xd56199, "purple": 0x9141ac, "slate": 0x6f8396,
}
INITIAL_PREFS = "/etc/chromium/master_preferences"
TONAL_SPOT = 1  # browser.theme.color_variant2: the variant of Chromium's own swatches

config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
user_data = os.path.join(config, "chromium")
prefs_file = os.path.join(user_data, "Default", "Preferences")
marker = os.path.join(user_data, ".gnome-accent")


def running():
    # Chromium's SingletonLock is a symlink to "<hostname>-<pid>".
    try:
        pid = int(os.readlink(os.path.join(user_data, "SingletonLock")).rpartition("-")[2])
    except (OSError, ValueError):
        return False
    return os.path.exists(f"/proc/{pid}")


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f)
    os.replace(path + ".tmp", path)


def set_accent(prefs, accent):
    theme = prefs.setdefault("browser", {}).setdefault("theme", {})
    # SkColor (opaque ARGB) stored as a signed 32-bit integer.
    theme["user_color2"] = (0xff000000 | ACCENTS[accent]) - (1 << 32)
    theme["color_variant2"] = TONAL_SPOT
    theme["is_grayscale2"] = False
    # "Classic" theme: with the GTK one Chromium ignores the color.
    prefs.setdefault("extensions", {}).setdefault("theme", {})["system_theme"] = 0


def main():
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup("org.gnome.desktop.interface", True) is None:
        return
    accent = Gio.Settings.new("org.gnome.desktop.interface").get_string("accent-color")
    if accent not in ACCENTS or running():
        return

    if not os.path.exists(prefs_file):
        if os.path.exists(os.path.join(user_data, "First Run")):
            return
        try:
            with open(INITIAL_PREFS) as f:
                prefs = json.load(f)
        except (OSError, ValueError):
            prefs = {}
        prefs.pop("distribution", None)  # first-run options, not preferences
        set_accent(prefs, accent)
        write_json(prefs_file, prefs)
        open(os.path.join(user_data, "First Run"), "w").close()
    else:
        try:
            with open(marker) as f:
                if f.read().strip() == accent:
                    return
        except OSError:
            pass
        with open(prefs_file) as f:
            prefs = json.load(f)
        set_accent(prefs, accent)
        write_json(prefs_file, prefs)
    with open(marker, "w") as f:
        f.write(accent + "\n")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # never keep Chromium from starting
        print(f"chromium-gnome sync-prefs: {e}", file=sys.stderr)
