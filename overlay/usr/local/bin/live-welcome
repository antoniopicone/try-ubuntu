#!/usr/bin/python3
"""live-welcome: the first-run welcome app of the GNOME live system (draft).

Starts in the live user's session (autologin) and walks through language,
keyboard layout, installing on a disk (when the computer has one with room
for it), the account (full name, username, password, email), its picture
(an avatar in one of DiceBear's CC0 styles, or the initials) and the
appearance (light/dark, accent color). The summary's "Start using Ubuntu"
button hands the choices to /usr/local/lib/live-welcome/setup-user (through
pkexec), which creates the user; then the live session logs out to GDM,
where the new user logs in with everything already applied.

Installing (/usr/local/lib/live-install/install-system, through pkexec)
moves the running system onto the chosen disk: the whole disk, erased, or
its free space, next to what is there. The user is then created on the
installed system, and instead of logging out the app asks to remove the
USB stick and restarts into the installed system.

Keyboard layout and appearance are previewed live in the running session.
The UI speaks English and Italian (switching as soon as a language is
picked); other languages fall back to English for now.
"""
import base64
import json
import os
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/local/lib/live-welcome")
sys.path.insert(0, "/usr/local/lib/live-common")
import avatars  # noqa: E402
import livespinner  # noqa: E402

APP_ID = "org.ubuntu.LiveWelcome"
SETUP_HELPER = "/usr/local/lib/live-welcome/setup-user"
INSTALL_HELPER = "/usr/local/lib/live-install/install-system"
LIVE = "/run/btrfslive"
DONE = "/var/lib/live-welcome/done"
STORAGE = "/run/btrfslive/storage"

