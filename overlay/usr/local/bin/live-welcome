CSS = """
.accent-button { min-width: 34px; min-height: 34px; padding: 0; border-radius: 9999px; }
.accent-button:checked { outline: 3px solid alpha(@window_fg_color, 0.8); outline-offset: 3px; }
.style-button { padding: 18px 28px; }
""" + "".join(f".accent-{name} {{ background: {color}; }}\n" for name, color in ACCENTS)


def username_from(fullname):
    """First word of the name, lowercased and reduced to valid characters."""
    first = fullname.strip().split(" ")[0] if fullname.strip() else ""
    name = re.sub(r"[^a-z0-9_-]", "", first.lower()
                  .translate(str.maketrans("àáâäèéêëìíîïòóôöùúûüçñ", "aaaaeeeeiiiioooouuuucn")))
    return name if re.match(r"[a-z]", name or "") else ""


def machine_kind():
    """vm, laptop or desktop: for the suggested computer name."""
    if subprocess.run(["systemd-detect-virt", "--quiet"]).returncode == 0:
        return "vm"
    try:
        chassis = int(open("/sys/class/dmi/id/chassis_type").read().strip())
    except (OSError, ValueError):
        return "desktop"
    # SMBIOS chassis types: portable, laptop, notebook, hand held, sub
    # notebook, tablet, convertible, detachable
    return "laptop" if chassis in (8, 9, 10, 11, 14, 30, 31, 32) else "desktop"


def hostname_for(username):
    return f"ubuntu-{machine_kind()}-{username}" if username else ""


def user_exists(name):
    try:
        import pwd
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


class WelcomeWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, default_width=760, default_height=640)
        self.interface = Gio.Settings.new("org.gnome.desktop.interface")
        self.inputs = Gio.Settings.new("org.gnome.desktop.input-sources")
        self.lang = self._initial_language()
        self.layout = dict((l[0], l[3]) for l in LANGUAGES)[self.lang]
        self.color_scheme = self.interface.get_string("color-scheme")
        if self.color_scheme not in ("default", "prefer-dark"):
            self.color_scheme = "default"
        self.accent = self.interface.get_string("accent-color")
        self._translatable = []  # (setter, key)
        self._username_edited = False
        self._hostname_edited = False
        self.styles = avatars.load_styles()
        # Installing: the disks it can go on (None until listed, [] for none),
        # the chosen one, and whether it's done (then the live medium is gone)
        self.targets = None
        self.target = None
        self.installed = False
        self.boot_entry = True

        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               vexpand=True)
        self.pages = [
            ("welcome", self._page_welcome()),
            ("language", self._page_language()),
            ("keyboard", self._page_keyboard()),
            ("install", self._page_install()),
            ("account", self._page_account()),
            *([("avatar", self._page_avatar())] if self.styles else []),
            ("appearance", self._page_appearance()),
            ("summary", self._page_summary()),
            ("finish", self._page_finish()),
        ]
        for name, widget in self.pages:
            self.stack.add_named(widget, name)
        # Not a step of its own: shown while installing, between "install"
        # and "account"
        self.stack.add_named(self._page_installing(), "installing")

        self.back = Gtk.Button(icon_name="go-previous-symbolic")
        self.back.connect("clicked", lambda *_: self._go(-1))
        header = Adw.HeaderBar()
        header.pack_start(self.back)
        self.window_title = Adw.WindowTitle()
        header.set_title_widget(self.window_title)

        self.next = Gtk.Button(halign=Gtk.Align.CENTER, margin_top=12, margin_bottom=18)
        self.next.add_css_class("suggested-action")
        self.next.add_css_class("pill")
        self.next.connect("clicked", self._on_next)
        # Enter anywhere (text fields included) means "Continue".
        self.set_default_widget(self.next)

        banner = Adw.Banner(revealed=self._storage() == "ram")
        self._tr(banner.set_title, "no_persist")
        self.banner = banner

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.add_top_bar(banner)
        view.set_content(self.stack)
        view.add_bottom_bar(self.next)
        self.set_content(view)

        self.set_icon_name("start-here")
        self._apply_layout()
        self._retranslate()
        self._update()
        GLib.idle_add(self.next.grab_focus)
        self._list_targets()

    # --- helpers -------------------------------------------------------------

    @staticmethod
    def _initial_language():
        # The session's language: the host's, when run-qemu.sh passed one
        # the image has (live-locale). In English, the live image's keyboard
        # layout (build.sh --xkb) hints the language instead.
        lang = os.environ.get("LANG", "")[:2]
        if lang != "en" and any(l[0] == lang for l in LANGUAGES):
            return lang
        try:
            layout = re.search(r'XKBLAYOUT="?([a-z]+)', open("/etc/default/keyboard").read())[1]
        except (OSError, TypeError):
            layout = "us"
        return next((l[0] for l in LANGUAGES if l[3] == layout), "en")

    @staticmethod
    def _storage():
        try:
            return open(STORAGE).read().strip()
        except OSError:
            return "unknown"

    def t(self, key):
        return STRINGS.get(self.lang, STRINGS["en"]).get(key) or STRINGS["en"][key]

    def _tr(self, setter, key):
        self._translatable.append((setter, key))

    def _retranslate(self):
        for setter, key in self._translatable:
            setter(self.t(key))
        if self.styles:
            self.avatar_editor.retranslate()
        if hasattr(self, "install_group"):
            self._fill_install()
        self.set_title(self.t("title"))
        self._update()

    @staticmethod
    def _page(child):
        clamp = Adw.Clamp(maximum_size=560, child=child, margin_top=24, margin_bottom=24,
                          margin_start=12, margin_end=12)
        return Gtk.ScrolledWindow(child=clamp, hscrollbar_policy=Gtk.PolicyType.NEVER)

    def _group(self, title_key, body_key):
        group = Adw.PreferencesGroup()
        self._tr(group.set_title, title_key)
        self._tr(group.set_description, body_key)
        return group

    def _radio_rows(self, group, items, current, on_select):
        """Rows of mutually exclusive check buttons; returns {value: check}."""
        checks, first = {}, None
        for value, label in items:
            check = Gtk.CheckButton(active=value == current)
            if first:
                check.set_group(first)
            first = first or check
            row = Adw.ActionRow(title=label, activatable_widget=check)
            row.add_prefix(check)
            check.connect("toggled", lambda c, v=value: c.get_active() and on_select(v))
            group.add(row)
            checks[value] = check
        return checks

    # --- pages ---------------------------------------------------------------

    def _page_welcome(self):
        # Yaru's start-here is the Ubuntu logo.
        status = Adw.StatusPage(vexpand=True, icon_name="start-here")
        self._tr(status.set_title, "welcome_title")
        self._tr(status.set_description, "welcome_body")
        return status

    def _page_language(self):
        group = self._group("language_title", "language_body")
        self.language_checks = self._radio_rows(
            group, [(l[0], l[1]) for l in LANGUAGES], self.lang, self._on_language)
        return self._page(group)

    def _page_keyboard(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        group = self._group("keyboard_title", "keyboard_body")
        self.layout_checks = self._radio_rows(group, LAYOUTS, self.layout, self._on_layout)
        test = Adw.PreferencesGroup()
        entry = Adw.EntryRow()
        self._tr(entry.set_title, "keyboard_test")
        test.add(entry)
        box.append(test)
        box.append(group)
        return self._page(box)

    def _page_install(self):
        self.install_group = self._group("install_title", "install_body")
        self.install_rows = []
        return self._page(self.install_group)

    def _fill_install(self):
        """The choices: keep trying it, or each disk it can go on."""
        for row in self.install_rows:
            self.install_group.remove(row)
        self.install_rows = []
        items = [(None, self.t("install_live"), self.t("install_live_body"))]
        for target in self.targets or []:
            size = GLib.format_size(target["size"])
            body = (self.t("mode_disk") if target["mode"] == "disk"
                    else self.t("mode_free").format(free=GLib.format_size(target["bytes"])))
            items.append((target, f"{target['model']} · {size} · {target['disk']}", body))
        first = None
        for target, title, subtitle in items:
            check = Gtk.CheckButton(active=target is self.target)
            if first:
                check.set_group(first)
            first = first or check
            row = Adw.ActionRow(title=GLib.markup_escape_text(title),
                                subtitle=GLib.markup_escape_text(subtitle),
                                activatable_widget=check)
            row.add_prefix(check)
            icon = "media-removable-symbolic" if target is None else (
                "drive-harddisk-symbolic" if target["mode"] == "free" else "edit-clear-all-symbolic")
            row.add_suffix(Gtk.Image(icon_name=icon))
            check.connect("toggled", lambda c, t=target: c.get_active() and self._on_target(t))
            self.install_group.add(row)
            self.install_rows.append(row)

    def _list_targets(self):
        """In the background: the disks install-system can use. Only on the
        live system, and the welcome app shows the page only when there are
        some."""
        if not os.path.isdir(LIVE):
            self.targets = []
            return

        def work():
            try:
                out = subprocess.run(["pkexec", INSTALL_HELPER, "list"], capture_output=True,
                                     text=True, timeout=60).stdout
                targets = json.loads(out.strip().splitlines()[-1])
                if not isinstance(targets, list):
                    targets = []
            except (OSError, subprocess.SubprocessError, ValueError, IndexError):
                targets = []
            GLib.idle_add(self._targets_listed, targets)
        threading.Thread(target=work, daemon=True).start()

    def _targets_listed(self, targets):
        self.targets = targets
        self._fill_install()
        return GLib.SOURCE_REMOVE

    def _on_target(self, target):
        self.target = target
        self._update()

    def _page_installing(self):
        self.installing_status = Adw.StatusPage(vexpand=True, icon_name="drive-harddisk-symbolic")
        self.install_progress = Gtk.ProgressBar(width_request=320, halign=Gtk.Align.CENTER)
        self.install_back = Gtk.Button(halign=Gtk.Align.CENTER, visible=False)
        self.install_back.add_css_class("pill")
        self._tr(self.install_back.set_label, "install_back")
        self.install_back.connect("clicked", lambda *_: self._back_to_install())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.install_progress)
        box.append(self.install_back)
        self.installing_status.set_child(box)
        return self.installing_status

    def _page_account(self):
        group = self._group("account_title", "account_body")
        self.fullname = Adw.EntryRow()
        self.username = Adw.EntryRow()
        self.password = Adw.PasswordEntryRow()
        self.password2 = Adw.PasswordEntryRow()
        self.email = Adw.EntryRow(input_purpose=Gtk.InputPurpose.EMAIL)
        self.hostname = Adw.EntryRow()
        for row, key in ((self.fullname, "fullname"), (self.username, "username"),
                         (self.password, "password"), (self.password2, "password2"),
                         (self.email, "email"), (self.hostname, "hostname")):
            self._tr(row.set_title, key)
            row.set_activates_default(True)
            group.add(row)
            row.connect("changed", self._on_account_changed)
        self.username.connect("changed", self._on_username_edited)
        self.hostname.connect("changed", self._on_hostname_edited)
        self.account_error = Gtk.Label(wrap=True, xalign=0, margin_top=12)
        self.account_error.add_css_class("error")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(group)
        box.append(self.account_error)
        return self._page(box)

    def _page_avatar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.append(self._group("avatar_title", "avatar_body"))
        self.avatar_editor = avatars.AvatarEditor(self.styles, self.t)
        box.append(self.avatar_editor)
        return self._page(box)

    def _page_appearance(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        style = self._group("style", "appearance_body")
        buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, margin_top=6)
        self.style_buttons = {}
        first = None
        for scheme, icon, key in (("default", "weather-clear-symbolic", "light"),
                                  ("prefer-dark", "weather-clear-night-symbolic", "dark")):
            content = Adw.ButtonContent(icon_name=icon)
            self._tr(content.set_label, key)
            button = Gtk.ToggleButton(child=content, active=scheme == self.color_scheme)
            button.add_css_class("style-button")
            if first:
                button.set_group(first)
            first = first or button
            button.connect("toggled", lambda b, s=scheme: b.get_active() and self._on_scheme(s))
            buttons.append(button)
            self.style_buttons[scheme] = button
        style.add(buttons)

        accent = Adw.PreferencesGroup()
        self._tr(accent.set_title, "accent")
        colors = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=9,
                             min_children_per_line=5, column_spacing=12, row_spacing=12,
                             halign=Gtk.Align.CENTER, margin_top=6)
        first = None
        for name, _ in ACCENTS:
            button = Gtk.ToggleButton(active=name == self.accent)
            button.add_css_class("accent-button")
            button.add_css_class(f"accent-{name}")
            self._tr(button.set_tooltip_text, name)
            if first:
                button.set_group(first)
            first = first or button
            button.connect("toggled", lambda b, n=name: b.get_active() and self._on_accent(n))
            colors.append(button)
        accent.add(colors)
        box.append(style)
        box.append(accent)
        return self._page(box)

    def _page_summary(self):
        group = self._group("summary_title", "summary_body")
        self.summary_rows = {}
        keys = ["row_name", "row_username", "row_email", "row_hostname", "row_language",
                "row_keyboard", "row_theme"]
        if self.styles:
            keys.insert(3, "row_picture")
        for key in keys:
            row = Adw.ActionRow(subtitle_selectable=True)
            row.add_css_class("property")
            self._tr(row.set_title, key)
            group.add(row)
            self.summary_rows[key] = row
        if not self.styles:
            return self._page(group)
        # The picture on top, as big as in the avatar page
        self.summary_avatar = Adw.Avatar(size=128, show_initials=True,
                                         halign=Gtk.Align.CENTER)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.append(self.summary_avatar)
        box.append(group)
        return self._page(box)

    def _page_finish(self):
        self.finish_status = Adw.StatusPage(vexpand=True)
        self.spinner = livespinner.Spinner(size=48)
        self.retry = Gtk.Button(halign=Gtk.Align.CENTER, visible=False)
        self.retry.add_css_class("pill")
        self._tr(self.retry.set_label, "retry")
        self.retry.connect("clicked", lambda *_: self._show("summary"))
        self.restart = Gtk.Button(halign=Gtk.Align.CENTER, visible=False)
        self.restart.add_css_class("pill")
        self.restart.add_css_class("suggested-action")
        self._tr(self.restart.set_label, "restart")
        self.restart.connect("clicked", lambda *_: self._reboot())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.spinner)
        box.append(self.retry)
        box.append(self.restart)
        self.finish_status.set_child(box)
        return self.finish_status

    # --- navigation ----------------------------------------------------------

    def _index(self):
        name = self.stack.get_visible_child_name()
        return [n for n, _ in self.pages].index(name)

    def _show(self, name):
        self.stack.set_visible_child_name(name)
        self._update()
        # Keyboard users: type straight into the form, or press Enter to go on.
        (self.fullname if name == "account" else self.next).grab_focus()

    def _go(self, step):
        index = min(max(self._index() + step, 0), len(self.pages) - 2)
        if self.pages[index][0] == "install" and (self.installed or not self.targets):
            index = min(max(index + step, 0), len(self.pages) - 2)
        self._show(self.pages[index][0])

    def _update(self):
        name = self.stack.get_visible_child_name() or "welcome"
        titles = {"welcome": "title", "language": "language_title",
                  "keyboard": "keyboard_title", "account": "account_title",
                  "avatar": "avatar_title", "appearance": "appearance_title", "summary": "summary_title",
                  "finish": "working_title", "install": "install_title",
                  "installing": "installing_title"}
        self.window_title.set_title(self.t(titles[name]))
        self.back.set_visible(name not in ("welcome", "finish", "installing")
                              and not (self.installed and name == "account"))
        self.next.set_visible(name not in ("finish", "installing"))
        next_key = {"welcome": "start", "summary": "finish"}.get(name, "continue")
        if name == "install" and self.target:
            next_key = "erase" if self.target["mode"] == "disk" else "install"
        self.next.set_label(self.t(next_key))
        self.next.set_sensitive(name != "account" or self._account_error() is None)
        if name == "account":
            error = self._account_error(show_all=False)
            self.account_error.set_label(self.t(error) if error else "")
        if name == "avatar":
            self.avatar_editor.set_name(self.fullname.get_text().strip())
        if name == "summary":
            self._fill_summary()

    def _on_next(self, *_):
        name = self.stack.get_visible_child_name()
        if name == "summary":
            self._finish()
        elif name == "install" and self.target:
            self._confirm_install()
        else:
            self._go(1)

    # --- installing ----------------------------------------------------------

    def _confirm_install(self):
        target = self.target
        values = {"model": target["model"], "disk": target["disk"],
                  "size": GLib.format_size(target["size"]),
                  "free": GLib.format_size(target["bytes"])}
        kind = "disk" if target["mode"] == "disk" else "free"
        dialog = Adw.AlertDialog(heading=self.t(f"confirm_{kind}_title").format(**values),
                                 body=self.t(f"confirm_{kind}_body").format(**values))
        dialog.add_response("cancel", self.t("cancel"))
        dialog.add_response("install", self.t("erase" if kind == "disk" else "install"))
        dialog.set_response_appearance(
            "install", Adw.ResponseAppearance.DESTRUCTIVE if kind == "disk"
            else Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: r == "install" and self._install(target))
        dialog.present(self)

    def _install(self, target):
        self.stack.set_visible_child_name("installing")
        self.installing_status.set_icon_name("drive-harddisk-symbolic")
        self.installing_status.set_title(self.t("installing_title"))
        self.installing_status.set_description(self.t("step_partition"))
        self.install_progress.set_visible(True)
        self.install_progress.set_fraction(0)
        self.install_back.set_visible(False)
        self._update()

        def work():
            reply = {"ok": False, "error": "install-system"}
            try:
                proc = subprocess.Popen(["pkexec", INSTALL_HELPER, "install", target["disk"],
                                         target["mode"]], stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True)
                last = ""
                for line in proc.stdout:
                    try:
                        message = json.loads(line)
                    except ValueError:
                        last = line.strip() or last
                        continue
                    if "step" in message:
                        GLib.idle_add(self._install_step, message["step"],
                                      message.get("fraction", 0))
                    else:
                        reply = message
                if proc.wait() != 0 and reply.get("ok"):
                    reply = {"ok": False, "error": last}
            except OSError as e:
                reply = {"ok": False, "error": str(e)}
            GLib.idle_add(self._install_done, reply)
        threading.Thread(target=work, daemon=True).start()

    def _install_step(self, step, fraction):
        self.installing_status.set_description(self.t(f"step_{step}"))
        # The copy is most of the time: the steps take parts of the bar
        start, size = {"partition": (0, 0.05), "copy": (0.05, 0.85), "boot": (0.9, 0.1)}[step]
        self.install_progress.set_fraction(start + size * fraction)
        return GLib.SOURCE_REMOVE

    def _install_done(self, reply):
        if not reply.get("ok"):
            self.installing_status.set_icon_name("dialog-warning-symbolic")
            self.installing_status.set_title(self.t("error_title"))
            self.installing_status.set_description(
                GLib.markup_escape_text(reply.get("error") or "install-system"))
            self.install_progress.set_visible(False)
            self.install_back.set_visible(True)
            return GLib.SOURCE_REMOVE
        self.installed = True
        self.boot_entry = reply.get("boot_entry", True)
        # The system is on the disk now: what's changed stays
        self.banner.set_revealed(False)
        self._show("account")
        return GLib.SOURCE_REMOVE

    def _back_to_install(self):
        # The disks may have changed (a half-made partition table): list
        # them again
        self.targets, self.target = None, None
        self._fill_install()
        self._show("install")
        self._list_targets()

    # --- choices -------------------------------------------------------------

    def _on_language(self, code):
        self.lang = code
        layout = dict((l[0], l[3]) for l in LANGUAGES)[code]
        if layout in self.layout_checks:
            self.layout_checks[layout].set_active(True)
        self._retranslate()

    def _on_layout(self, layout):
        self.layout = layout
        self._apply_layout()

    def _apply_layout(self):
        # Live preview: the live session switches to the chosen layout.
        name, _, variant = self.layout.partition(":")
        source = f"{name}+{variant}" if variant else name
        self.inputs.set_value("sources", GLib.Variant("a(ss)", [("xkb", source)]))

    def _on_scheme(self, scheme):
        self.color_scheme = scheme
        self.interface.set_string("color-scheme", scheme)

    def _on_accent(self, accent):
        self.accent = accent
        self.interface.set_string("accent-color", accent)

    def _on_username_edited(self, row):
        if row.get_text() != username_from(self.fullname.get_text()):
            self._username_edited = True

    def _on_hostname_edited(self, row):
        if row.get_text() != hostname_for(self.username.get_text()):
            self._hostname_edited = True

    def _on_account_changed(self, row):
        if row is self.fullname and not self._username_edited:
            self.username.handler_block_by_func(self._on_username_edited)
            self.username.set_text(username_from(row.get_text()))
            self.username.handler_unblock_by_func(self._on_username_edited)
        if row in (self.fullname, self.username) and not self._hostname_edited:
            self.hostname.handler_block_by_func(self._on_hostname_edited)
            self.hostname.set_text(hostname_for(self.username.get_text()))
            self.hostname.handler_unblock_by_func(self._on_hostname_edited)
        self._update()

    def _account_error(self, show_all=True):
        """The first problem with the account fields (a string key), or None.
        With show_all=False, fields still empty are not reported yet."""
        fullname = self.fullname.get_text().strip()
        username = self.username.get_text()
        password, password2 = self.password.get_text(), self.password2.get_text()
        email = self.email.get_text().strip()
        hostname = self.hostname.get_text().strip()
        checks = [
            (fullname, not fullname or re.search(r"[:,]", fullname), "err_fullname"),
            (username, not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", username), "err_username"),
            (username, user_exists(username), "err_username_taken"),
            (password, len(password) < 6, "err_password"),
            (password2, password != password2, "err_password2"),
            (email, not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email), "err_email"),
            (hostname, not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", hostname),
             "err_hostname"),
        ]
        for value, bad, key in checks:
            if bad and (show_all or value):
                return key
        return None

    def _choices(self):
        return {
            "fullname": self.fullname.get_text().strip(),
            "username": self.username.get_text(),
            "password": self.password.get_text(),
            "email": self.email.get_text().strip(),
            "hostname": self.hostname.get_text().strip(),
            "locale": dict((l[0], l[2]) for l in LANGUAGES)[self.lang],
            "layout": self.layout,
            "color_scheme": self.color_scheme,
            "accent": self.accent,
            "avatar": base64.b64encode(self._avatar_png()).decode() if self._avatar_png() else "",
        }

    def _avatar_png(self):
        return self.avatar_editor.png if self.styles else None

    def _fill_summary(self):
        c = self._choices()
        values = {
            "row_name": c["fullname"],
            "row_username": c["username"],
            "row_email": c["email"],
            "row_hostname": c["hostname"],
            "row_picture": self.avatar_editor.title if self._avatar_png() else self.t("initials"),
            "row_language": dict((l[0], l[1]) for l in LANGUAGES)[self.lang],
            "row_keyboard": dict(LAYOUTS)[self.layout],
            "row_theme": f"{self.t('dark' if self.color_scheme == 'prefer-dark' else 'light')}, "
                         f"{self.t(self.accent)}",
        }
        for key, row in self.summary_rows.items():
            row.set_subtitle(GLib.markup_escape_text(values[key]))
        if self.styles:
            self.summary_avatar.set_text(c["fullname"])
            avatars.show(self.summary_avatar, self.avatar_editor.texture)

    # --- finish --------------------------------------------------------------

    def _finish(self):
        self._show("finish")
        self.finish_status.set_title(self.t("working_title"))
        self.finish_status.set_description(self.t("working_body"))
        self.spinner.set_visible(True)
        self.retry.set_visible(False)
        try:
            proc = Gio.Subprocess.new(
                ["pkexec", SETUP_HELPER],
                Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            self._setup_failed(e.message)
            return
        proc.communicate_utf8_async(json.dumps(self._choices()), None, self._on_setup_done)

    def _setup_failed(self, message):
        self.spinner.set_visible(False)
        self.finish_status.set_title(self.t("error_title"))
        self.finish_status.set_description(GLib.markup_escape_text(message or "setup-user failed"))
        self.retry.set_visible(True)
        self.retry.grab_focus()

    def _on_setup_done(self, proc, result):
        try:
            _, out, _ = proc.communicate_utf8_finish(result)
            reply = json.loads((out or "").strip().splitlines()[-1])
        except (GLib.Error, ValueError, IndexError) as e:
            reply = {"ok": False, "error": getattr(e, "message", None) or str(e)}
        if not reply.get("ok"):
            self._setup_failed(reply.get("error", ""))
            return
        self.spinner.set_visible(False)
        self.finish_status.set_icon_name("object-select-symbolic")
        if self.installed:
            # The live user goes at the next boot (live-retire-user.service)
            body = self.t("done_installed_body").format(user=reply["user"])
            if not self.boot_entry:
                body += "\n\n" + self.t("no_boot_entry")
            self.finish_status.set_title(self.t("installed_title"))
            self.finish_status.set_description(GLib.markup_escape_text(body))
            self.restart.set_visible(True)
            self.restart.grab_focus()
            return
        self.finish_status.set_title(self.t("done_title"))
        self.finish_status.set_description(
            GLib.markup_escape_text(self.t("done_body").format(user=reply["user"])))
        GLib.timeout_add_seconds(3, self._logout)

    def _reboot(self):
        Gio.Subprocess.new(["systemctl", "reboot"], Gio.SubprocessFlags.NONE)

    def _logout(self):
        Gio.Subprocess.new(["gnome-session-quit", "--logout", "--no-prompt"],
                           Gio.SubprocessFlags.NONE)
        return GLib.SOURCE_REMOVE


class WelcomeApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        window = self.get_active_window() or WelcomeWindow(self)
        window.present()


if __name__ == "__main__":
    # Once the real user exists there is nothing left to do.
    if os.path.exists(DONE):
        sys.exit(0)
    sys.exit(WelcomeApp().run(sys.argv))
