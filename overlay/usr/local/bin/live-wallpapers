#!/usr/bin/python3
"""live-wallpapers: the Wallpapers app. Finds a wallpaper in several photo
services at once and sets it (/usr/local/lib/live-wallpapers: sources.py
for the services, palette.py for the colors, store.py for what's kept,
desktop.py for the GNOME settings).

  - Discover: a search, the photo of the day, moods (searches ready to
    run), a few museum works. "Surprise Me" opens a random wallpaper.
  - Search: the results of every source that's on, dealt together, with
    filters: sources, type, color, "fits my screen", "free works only",
    order. The services that can't filter by color are filtered here, on
    the thumbnails' own colors. A search can be saved.
  - Preview: the wallpaper on a small desktop before it's set, for the
    light or the dark style. Position (fill, with the framing dragged; fit;
    center), blur and darkening are rendered into the image that's set.
    "Match the theme" sets the GNOME accent color closest to the picture's
    colors, and yaru-accent-sync the icons.
  - Collection: the saved wallpapers.
  - Automatic: a new wallpaper every hour, day, week or login, from the
    photo of the day, the collection or a saved search: systemd user units
    run /usr/local/lib/live-wallpapers/rotate.
  - Sources: which services are on, the user's own folders of pictures
    (searched with their subfolders, on any disk that's mounted), Pixabay's
    API key, and the ones left out (Unsplash, Pexels: their API terms forbid
    wallpaper apps).
"""
import copy
import os
import sys
import threading
from concurrent.futures import ThreadPoolExecutor

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gsk", "4.0")
gi.require_version("Graphene", "1.0")
