#!/bin/sh
# ghostty: starts Ghostty (/usr/bin/ghostty.real) with OpenGL in software
# on a virtio-gpu display, and Ptyxis (GNOME's terminal on Ubuntu) when
# Ghostty can't start.
#
# Ghostty needs OpenGL 4.3. On a Mac, QEMU's virgl renders on OpenGL ES
# (ANGLE on Metal), and the guest's virgl driver offers less than that:
# Ghostty then can't draw. llvmpipe has 4.5 and is enough for a terminal;
# the rest of the desktop keeps the GPU. Only on the live system: once it's
# installed on a disk (/etc/try-ubuntu/installed), Ghostty uses the GPU
# like any other app. On real hardware, or any other GPU, nothing changes.
# LIBGL_ALWAYS_SOFTWARE=0 in the environment keeps the GPU for Ghostty on the
# live system too.
#
# Started by systemd (the unit is Type=notify-reload): no fallback and no
# wrapping, see below. Otherwise, fallback: when Ghostty fails within its first seconds (no OpenGL, a
# broken config...), Ptyxis opens instead, with the same command, and a
# notification says so. Ghostty's own subcommands (+list-fonts...) never
# fall back.
#
# /usr/bin/ghostty is this script (build-rootfs.sh diverts the package's
# binary): the .desktop file, D-Bus and systemd start that path.
if [ ! -e /etc/try-ubuntu/installed ]; then
  for driver in /sys/class/drm/card*/device/driver; do
    link=$(readlink "$driver") || continue
    if [ "${link##*/}" = virtio_gpu ]; then
      export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE-1}"
      break
    fi
  done
fi

# Started by systemd as the service's main process (the .desktop file is
# DBusActivatable, so that's the dock too): Ghostty has to replace this
# script. The unit is Type=notify-reload with NotifyAccess=main: READY=1
# from a child is ignored and systemd kills the service after
# TimeoutStartSec (90 s); the reload signal (SIGUSR2) would hit this shell.
# systemd reports the failure itself there, so no fallback.
if [ -n "${NOTIFY_SOCKET:-}" ] && [ "${SYSTEMD_EXEC_PID:-}" = "$$" ]; then
  exec /usr/bin/ghostty.real "$@"
fi

case "${1:-}" in
  +*|--version|--help|-h) exec /usr/bin/ghostty.real "$@" ;;
esac

start=$(date +%s)
status=0
/usr/bin/ghostty.real "$@" || status=$?
if [ "$status" -eq 0 ] || [ $(($(date +%s) - start)) -ge 10 ] || ! command -v ptyxis >/dev/null; then
  exit "$status"
fi

# Ghostty's options that matter to Ptyxis: the working directory and the
# command (-e CMD ARGS..., what xdg-terminal-exec passes); the rest is
# Ghostty's own.
dir="" cmd=""
while [ $# -gt 0 ]; do
  case "$1" in
    --working-directory=*) dir=${1#*=} ;;
    -e) shift; cmd=1; break ;;
  esac
  shift
done
notify-send -a Terminal -i org.gnome.Ptyxis "Ghostty didn't start" \
  "Opened Ptyxis instead. To see why: ghostty.real in Ptyxis." 2>/dev/null || true
if [ -n "$cmd" ] && [ $# -gt 0 ]; then
  # Ptyxis' -x takes the command as one string: each argument quoted
  line=""
  for a in "$@"; do
    line="$line '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
  done
  set -- -x "$line"
else
  set --
fi
exec ptyxis --new-window ${dir:+--working-directory="$dir"} "$@"
