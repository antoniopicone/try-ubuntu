#!/usr/bin/python3
"""live-ai: the AI app. Sets up AI on this computer, each part optional:
  - the official desktop apps: Claude (beta for Linux) and ChatGPT (preview,
    with Codex)
  - terminal agents: Claude Code, Codex, OpenCode. The system's skills
    (/usr/local/share/live-ai/skills) are linked into each, so they know how
    to configure this system, install apps and diagnose crashes; one is the
    default (live-agent), which crash notifications hand crashes to
  - a local chat model with Ollama, sized to this computer's memory
    (live-ai-resources), set as OpenCode's model
  - a local knowledge base (qmd, through live-kb) of the user's documents and
    projects, which the agents the user picks can search over MCP
The system installs go through /usr/local/lib/live-ai/install-ai (pkexec,
the user's password); the rest stays in the home folder (aisetup.py).

At the first login of the user live-welcome created it comes last, after
Cloud Backup (live-backup --first-run opens it with --first-run); afterwards
it's in the app grid.
"""
import os
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/local/lib/live-ai")
sys.path.insert(0, "/usr/local/lib/live-common")
import aisetup  # noqa: E402
import livespinner  # noqa: E402

APP_ID = "org.ubuntu.LiveAI"

