    # id, package, command, name key, subtitle key
    ("claude-desktop", "claude-desktop", "claude-desktop", "claude_app", "claude_app_body"),
    ("chatgpt", "chatgpt", "chatgpt", "chatgpt_app", "chatgpt_app_body"),
]
TERMINAL_AGENTS = [
    # command, name, subtitle key
    ("claude", "Claude Code", "claude_code_body"),
    ("codex", "Codex", "codex_body"),
    ("opencode", "OpenCode", "opencode_body"),
]

