#!/usr/bin/env bash
# live-debug: a diagnostic summary of this system, for people and AI agents.
# It never asks for a password (so it can't hang on a sudo prompt), changes
# nothing, and shows no private content: unit names, versions, log lines.
#
#   live-debug                  every section
#   live-debug --section NAME   one of them
#   live-debug --list           the sections
set -uo pipefail

SECTIONS=(system session failed errors crashes storage boot ai)

have() { command -v "$1" >/dev/null 2>&1; }
hdr()  { printf '\n## %s\n' "$1"; }
run()  { "$@" 2>&1 || true; }

s_system() {
  hdr "System"
  . /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-?}"
  echo "kernel: $(uname -r) ($(uname -m))"
  have gnome-shell && run gnome-shell --version
  echo "virtualization: $(systemd-detect-virt 2>/dev/null || echo none)"
  if [[ -f /etc/try-ubuntu/installed ]]; then echo "installed on a disk"; else echo "live system"; fi
  echo "uptime: $(uptime -p 2>/dev/null || true)"
}

s_session() {
  hdr "Session"
  echo "type: ${XDG_SESSION_TYPE:-?}  desktop: ${XDG_CURRENT_DESKTOP:-?}"
  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then echo "session bus: yes"
  else echo "session bus: NONE (gsettings saves nothing from here)"; fi
  if have gnome-extensions; then
    echo "enabled extensions:"; run gnome-extensions list --enabled | sed 's/^/  /'
  fi
}

s_failed() {
  hdr "Failed units"
  echo "system:"; run systemctl --failed --no-legend --plain | sed 's/^/  /'
  echo "user:";   run systemctl --user --failed --no-legend --plain | sed 's/^/  /'
}

s_errors() {
  hdr "Errors since boot (last 40)"
  run journalctl -b -p err --no-pager -q -o short-iso | tail -40
}

s_crashes() {
  hdr "Crashes"
  echo "core_pattern: $(cat /proc/sys/kernel/core_pattern 2>/dev/null)"
  if have coredumpctl; then
    echo "last 7 days:"
    run coredumpctl list --since=-7d --no-pager --no-legend | tail -15 | sed 's/^/  /'
  else
    echo "coredumpctl isn't installed (systemd-coredump)"
  fi
  echo "out of memory (this boot):"
  run journalctl -k -b --no-pager -q -o short-iso | grep -i -E 'out of memory|oom-kill' | tail -5 | sed 's/^/  /'
}

s_storage() {
  hdr "Space and snapshots"
  run df -h -x tmpfs -x devtmpfs -x efivarfs -x squashfs
  run findmnt -t btrfs -no TARGET,SOURCE,OPTIONS | sed 's/^/  /'
  if have snapper; then
    for c in root home; do
      echo "snapper $c (last 5):"
      run snapper -c "$c" list 2>&1 | tail -5 | sed 's/^/  /'
    done
  fi
}

s_boot() {
  hdr "Boot"
  [[ -r /run/btrfslive/booted-snapshot ]] && echo "booted from snapshot $(cat /run/btrfslive/booted-snapshot)"
  echo "secure boot: $(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | tr -d ' ' || echo '?')"
  have efibootmgr && run efibootmgr | grep -E '^(BootCurrent|BootOrder)'
  have systemd-analyze && run systemd-analyze 2>/dev/null | head -1
}

s_ai() {
  hdr "AI"
  have live-agent && run live-agent --list
  echo "crash notifications: $(systemctl --user is-active live-crash-watch.service 2>/dev/null || true)"
  if have ollama; then
    echo "ollama: $(systemctl is-active ollama 2>/dev/null || true)"
    run ollama list | head -6 | sed 's/^/  /'
  fi
  if have qmd; then
    echo "knowledge base:"; run qmd status | head -12 | sed 's/^/  /'
    echo "automatic updates: $(systemctl --user is-enabled live-kb-update.timer 2>/dev/null || echo no)"
  fi
  log="${XDG_STATE_HOME:-$HOME/.local/state}/live-ai/agent-changes.log"
  if [[ -s "$log" ]]; then echo "the agents' last changes:"; tail -5 "$log" | sed 's/^/  /'; fi
}

case "${1-}" in
  -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list) printf '%s\n' "${SECTIONS[@]}"; exit 0 ;;
  --section)
    for x in "${SECTIONS[@]}"; do
      if [[ "$x" == "${2-}" ]]; then "s_$x"; exit 0; fi
    done
    echo "live-debug: no section '${2-}' (see --list)" >&2; exit 2 ;;
  "") for x in "${SECTIONS[@]}"; do "s_$x"; done ;;
  *) echo "live-debug: unknown option: $1" >&2; exit 2 ;;
esac
