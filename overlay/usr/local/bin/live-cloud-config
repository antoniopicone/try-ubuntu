#!/usr/bin/python3
"""live-cloud-config: the Cloud Config app. Connects this computer to the
user's clouds, which then show up in Files and can hold Cloud Backup's
backups (see /usr/local/lib/live-backup/accounts.py):
  - Google Drive, OneDrive, Dropbox: sign-in in the browser (rclone's own)
  - Nextcloud: the server's address, then approval in the browser (Login
    Flow v2, which gives an app password)
  - iCloud Drive: Apple ID, password and the code sent by SMS (icloud-linux,
    which then mounts it in ~/iCloud)
See providers.py for each. Every account is mounted in the home folder,
with its place in Files' sidebar (mount.py), unless "Show the clouds in
Files" is off.

At the first login of the user live-welcome created it starts by itself
(--first-run, ~/.config/autostart): first the network (the clouds need it:
a cable, or a Wi-Fi network and its password) when there is none, then
Tailscale, then the clouds, and "Continue with the Backups" opens Cloud
Backup (live-backup --first-run).
"""
import os
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/local/lib/live-backup")
sys.path.insert(0, "/usr/local/lib/live-common")
import accounts  # noqa: E402
import cloud  # noqa: E402
import livespinner  # noqa: E402
import mount  # noqa: E402
import netsetup  # noqa: E402
import providers  # noqa: E402

