#!/usr/bin/python3
"""live-backup: the Cloud Backup app. Sets up, and then shows, the encrypted
backups of the home folder (restic, see /usr/local/lib/live-backup).

At the first login of the user live-welcome created it starts by itself
(--first-run, ~/.config/autostart) and asks where to keep the backups:
  - Google Drive, OneDrive, Dropbox: sign-in in the browser (rclone's own)
  - Nextcloud: the server's address, then approval in the browser (Login
    Flow v2, which gives an app password)
  - iCloud Drive: Apple ID, password and the code sent by SMS (icloud-linux,
    which then mounts it in ~/iCloud)
  - a Samba share, an SFTP server (password or key file): a form
See providers.py for each. Then the folder, picked in a tree of the
destination's folders, and a recovery key the app makes and shows once,
which encrypts the backups on this computer before they leave it, twice
(restic, and rclone's crypt for the names: see cloud.py). Backups already
in the folder are opened with their recovery key. "Later" skips it all: the
app stays in the app grid.

When the chosen folder already has backups (an earlier install, another
computer), it offers to restore the newest one first (restore.py): what
comes back, counted by type, and what it replaces. Once set up it shows the
last backup and can start one, restore, change the destination or stop the
backups.
"""
import os
import pwd
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Adw, Gio, GLib, GObject, Gtk, Pango, PangoCairo  # noqa: E402

sys.path.insert(0, "/usr/local/lib/live-backup")
import cloud  # noqa: E402
import mount  # noqa: E402
import providers  # noqa: E402
import restore  # noqa: E402

APP_ID = "org.ubuntu.LiveBackup"
AUTOSTART = os.path.expanduser(f"~/.config/autostart/{APP_ID}.desktop")

