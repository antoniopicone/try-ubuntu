def t(key, **kw):
    lang = os.environ.get("LANG", "")[:2]
    return STRINGS.get(lang, STRINGS["en"]).get(key, STRINGS["en"][key]).format(**kw)


def in_thread(work, done):
    """work() in a thread, then done(result, error) in the main loop."""
    def run():
        try:
            result, error = work(), None
        except Exception as e:  # shown to the user
            result, error = None, getattr(e, "message", None) or str(e) or type(e).__name__
        GLib.idle_add(lambda: done(result, error) and False)
    threading.Thread(target=run, daemon=True).start()


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def restic(config, env, *args):
    return subprocess.run(cloud.restic_cmd(config, *args, remote=cloud.SETUP_REMOTE), env=env,
                          capture_output=True, text=True)


class Folder(GObject.Object):
    def __init__(self, name, path):
        super().__init__()
        self.name, self.path = name, path


class BackupWindow(Adw.ApplicationWindow):
    def __init__(self, app, first_run):
        super().__init__(application=app, default_width=760, default_height=720,
                         title=t("title"), icon_name=APP_ID)
        self.first_run = first_run
        self.provider = None
        self.identity = ""
        self.waiting = False
        self.login = self.login_url = self.icloud = None
        self.code_message = ""
        self.stores = {}
        self.history = []

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               vexpand=True)
        for name, page in (("choose", self._page_choose()), ("wait", self._page_wait()),
                           ("nextcloud", self._page_nextcloud()), ("icloud", self._page_icloud()),
                           ("phones", self._page_phones()), ("code", self._page_code()),
                           ("samba", self._page_samba()), ("sftp", self._page_sftp()),
                           ("folder", self._page_folder()), ("unlock", self._page_unlock()),
                           ("key", self._page_key()), ("verify", self._page_verify()),
                           ("working", self._page_working()), ("error", self._page_error()),
                           ("done", self._page_done()), ("status", self._page_status()),
                           ("restore", self._page_restore()),
                           ("restoring", self._page_restoring()),
                           ("restored", self._page_restored())):
            self.stack.add_named(page, name)
        self.stack.connect("notify::visible-child-name", self._on_page)
        self.back = Gtk.Button(icon_name="go-previous-symbolic", tooltip_text=t("back"))
        self.back.connect("clicked", lambda *_: self._back())
        header = Adw.HeaderBar()
        header.pack_start(self.back)
        self.toasts = Adw.ToastOverlay(child=self.stack)
        view = Adw.ToolbarView(content=self.toasts)
        view.add_top_bar(header)
        self.set_content(view)

        configured = cloud.load_config() and not first_run
        self._show("status" if configured else "choose", remember=False)
        if configured:
            self._refresh_status()

    # --- helpers -----------------------------------------------------------------

    @staticmethod
    def _page(*children):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        for child in children:
            box.append(child)
        clamp = Adw.Clamp(maximum_size=560, child=box, margin_top=24, margin_bottom=24,
                          margin_start=12, margin_end=12)
        return Gtk.ScrolledWindow(child=clamp, hscrollbar_policy=Gtk.PolicyType.NEVER)

    @staticmethod
    def _button(label, suggested=False, destructive=False):
        button = Gtk.Button(label=label, halign=Gtk.Align.CENTER)
        button.add_css_class("pill")
        if suggested:
            button.add_css_class("suggested-action")
        if destructive:
            button.add_css_class("destructive-action")
        return button

    def _form(self, title, body, rows, on_continue, extra=()):
        """A page with a group of rows, an error line, Continue and the
        `extra` widgets. Returns (page, group, error label)."""
        group = Adw.PreferencesGroup(title=t(title), description=t(body))
        for row in rows:
            group.add(row)
            if isinstance(row, Adw.EntryRow):
                row.connect("entry-activated", lambda *_: on_continue())
        error = Gtk.Label(wrap=True, xalign=0, margin_top=12)
        error.add_css_class("error")
        group.add(error)
        button = self._button(t("continue"), suggested=True)
        button.connect("clicked", lambda *_: on_continue())
        return self._page(group, button, *extra), group, error

    @staticmethod
    def _entry(key, password=False, text=""):
        row = (Adw.PasswordEntryRow if password else Adw.EntryRow)(title=t(key))
        row.set_text(text)
        return row

    def _show(self, name, remember=True):
        current = self.stack.get_visible_child_name()
        if remember and current and current not in ("wait", "working", "error"):
            self.history.append(current)
        self.stack.set_visible_child_name(name)
        self.back.set_visible(bool(self.history) and name not in ("working", "done"))

    def _back(self):
        self._cancel()
        if self.history:
            self.stack.set_visible_child_name(self.history.pop())
        self.back.set_visible(bool(self.history))

    def _cancel(self):
        """Stop what's waiting: a browser sign-in, an iCloud sign-in."""
        self.waiting = False
        if self.login and self.login.poll() is None:
            self.login.terminate()
        if self.icloud:
            self.icloud.cancel()
            self.icloud = None

    def _toast(self, message):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(message), timeout=6))

    def _name(self):
        return cloud.PROVIDERS.get(self.provider, "")

    def _working(self, title, body=""):
        self.working_status.set_title(title)
        self.working_status.set_description(body)
        self._show("working")

    def _on_page(self, *_):
        name = self.stack.get_visible_child_name()
        focus = {"nextcloud": self.nc_server, "icloud": self.apple_id, "code": self.code_entry,
                 "samba": self.smb_host, "sftp": self.sftp_host, "unlock": self.unlock_entry,
                 "verify": self.verify_rows[0]}
        if name in focus:
            focus[name].grab_focus()

    # --- choose: where the backups go ------------------------------------------

    def _page_choose(self):
        group = Adw.PreferencesGroup(title=t("choose_title"), description=t("choose_body"))
        for dest, icon, body in DESTINATIONS:
            row = Adw.ActionRow(title=cloud.PROVIDERS[dest], subtitle=t(body), activatable=True)
            row.add_prefix(Gtk.Image(icon_name=icon, pixel_size=32))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _, d=dest: self._pick(d))
            group.add(row)
        e2e = Adw.PreferencesGroup()
        row = Adw.ActionRow(title=t("e2e_title"), subtitle=t("e2e_body"))
        row.add_prefix(Gtk.Image(icon_name="channel-secure-symbolic"))
        e2e.add(row)
        later = self._button(t("later"))
        later.connect("clicked", lambda *_: self._later())
        later.set_visible(cloud.load_config() is None)
        return self._page(group, e2e, later)

    def _later(self):
        if os.path.exists(AUTOSTART):
            os.remove(AUTOSTART)
        self.close()

    def _pick(self, provider):
        self.provider = provider
        if provider in providers.OAUTH:
            self._oauth()
        else:
            self._show(provider)

    # --- waiting for the browser ----------------------------------------------------

    def _page_wait(self):
        self.wait_status = Adw.StatusPage(icon_name="web-browser-symbolic", vexpand=True,
                                          title=t("wait_title"))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(Adw.Spinner(width_request=32, height_request=32))
        self.wait_again = self._button(t("open_browser"))
        self.wait_again.connect("clicked", lambda *_: self._open_uri(self.login_url))
        box.append(self.wait_again)
        cancel = self._button(t("cancel"))
        cancel.connect("clicked", lambda *_: self._back())
        box.append(cancel)
        self.wait_status.set_child(box)
        return self.wait_status

    def _wait_browser(self, body):
        self.wait_status.set_description(body)
        self.wait_again.set_visible(False)
        self.login_url = None
        self.waiting = True
        self._show("wait")

    def _open_uri(self, url):
        self.login_url = url
        self.wait_again.set_visible(True)
        Gtk.UriLauncher.new(url).launch(self, None, None, None)

    # --- Google Drive, OneDrive, Dropbox: rclone's sign-in ------------------------

    def _oauth(self):
        self._cancel()
        self._wait_browser(t("browser_body", provider=self._name()))
        provider = self.provider
        login = self.login = subprocess.Popen(providers.authorize_cmd(provider), text=True,
                                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)

        def run():
            errors = []
            for line in login.stderr:
                url = providers.authorize_url(line)
                if url:
                    GLib.idle_add(lambda u=url: self._open_uri(u) and False)
                elif "ERROR" in line or "Failed" in line:
                    errors.append(line.split(":", 3)[-1].strip())
            token = providers.token_from(login.stdout.read())
            login.wait()
            GLib.idle_add(lambda: self._oauth_done(login, provider, token, errors) and False)
        threading.Thread(target=run, daemon=True).start()

    def _oauth_done(self, login, provider, token, errors):
        if login is not self.login or not self.waiting:  # cancelled
            return
        self.waiting = False
        if not token:
            self._error(errors[-1] if errors else t("err_sign_in"))
            return
        self._working(t("connecting", provider=self._name()))

        def work():
            cloud.set_setup_remote(providers.oauth_remote(provider, token))
            providers.check_remote()
            return providers.identity()
        in_thread(work, lambda who, error: self._error(error) if error
                  else self._open_folders(who))

    # --- Nextcloud: Login Flow v2 ----------------------------------------------------

    def _page_nextcloud(self):
        self.nc_server = self._entry("server")
        self.nc_server.set_input_purpose(Gtk.InputPurpose.URL)
        page, _, self.nc_error = self._form("nextcloud_title", "nextcloud_body",
                                            [self.nc_server], self._nextcloud)
        return page

    def _nextcloud(self):
        try:
            server = providers.nextcloud_server(self.nc_server.get_text())
        except providers.SignInError:
            self.nc_error.set_label(t("required"))
            return
        self.nc_error.set_label("")
        self._working(t("connecting", provider=self._name()))

        def started(flow, error):
            if error:
                self._error(error)
                return
            self._wait_browser(t("nextcloud_wait_body"))
            self._open_uri(flow["login"])
            in_thread(lambda: self._nextcloud_finish(flow), self._nextcloud_done)
        in_thread(lambda: providers.nextcloud_start(server), started)

    def _nextcloud_finish(self, flow):
        login = providers.nextcloud_poll(flow, cancelled=lambda: not self.waiting)
        if login is None:
            return None
        cloud.set_setup_remote(providers.nextcloud_remote(login))
        providers.check_remote()
        host = GLib.Uri.parse(login["server"], GLib.UriFlags.NONE).get_host()
        return f"{login['loginName']}@{host}"

    def _nextcloud_done(self, who, error):
        if not self.waiting:  # cancelled, or timed out
            return
        self.waiting = False
        if error or who is None:
            self._error(error or t("err_sign_in"))
        else:
            self._open_folders(who)

    # --- iCloud Drive: icloud-linux ---------------------------------------------------

    def _page_icloud(self):
        self.apple_id = self._entry("apple_id")
        self.apple_id.set_input_purpose(Gtk.InputPurpose.EMAIL)
        self.apple_password = self._entry("password_apple", password=True)
        page, _, self.icloud_error = self._form("icloud_title", "icloud_body",
                                                [self.apple_id, self.apple_password],
                                                self._icloud)
        return page

    def _icloud(self):
        apple_id, password = self.apple_id.get_text().strip(), self.apple_password.get_text()
        if not apple_id or not password:
            self.icloud_error.set_label(t("required"))
            return
        self.icloud_error.set_label("")
        self._cancel()
        self._working(t("icloud_working"))
        self.icloud = providers.ICloudSignIn(
            apple_id, password, lambda kind, data: GLib.idle_add(
                lambda: self._icloud_event(kind, data) and False))
        self.icloud.start()

    def _icloud_event(self, kind, data):
        if self.icloud is None:  # cancelled
            return
        if kind == "phones":
            for row in self.phone_rows:
                self.phones_group.remove(row)
            self.phone_rows.clear()
            for index, phone in enumerate(data):
                row = Adw.ActionRow(title=phone, activatable=True)
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _, i=index: self._icloud_phone(i))
                self.phones_group.add(row)
                self.phone_rows.append(row)
            self.stack.set_visible_child_name("phones")
            self.back.set_visible(True)
        elif kind == "wrong_code":
            # icloudctl asks again right after: shown with that prompt
            left = re.search(r"\((\d+) attempt", data)
            self.code_message = t("code_wrong", left=left[1] if left else "?")
        elif kind == "code":
            self.code_group.set_description(t("code_body", phone=data) if data
                                            else t("code_body_any"))
            self.code_error.set_label(self.code_message)
            self.code_message = ""
            self.code_entry.set_text("")
            self.stack.set_visible_child_name("code")
            self.back.set_visible(True)
        elif kind == "done":
            self.icloud = None
            self._working(t("icloud_mounting"))
            # restart: an icloudd already running (an earlier attempt, a
            # backup) still has no session, and would show an empty drive
            in_thread(lambda: providers.icloud_start(restart=True),
                      lambda _r, error: self._error(f"{t('icloud_unavailable')}\n\n{error}")
                      if error else self._open_folders(data))
        elif kind == "error":
            self.icloud = None
            self._error(data)

    def _page_phones(self):
        self.phones_group = Adw.PreferencesGroup(title=t("phones_title"),
                                                 description=t("phones_body"))
        self.phone_rows = []
        return self._page(self.phones_group)

    def _icloud_phone(self, index):
        self.stack.set_visible_child_name("working")
        self.icloud.choose(index)

    def _page_code(self):
        self.code_entry = self._entry("code")
        self.code_entry.set_input_purpose(Gtk.InputPurpose.DIGITS)
        page, self.code_group, self.code_error = self._form(
            "code_title", "code_body_any", [self.code_entry], self._icloud_code)
        return page

    def _icloud_code(self):
        code = "".join(c for c in self.code_entry.get_text() if c.isdigit())
        if len(code) != 6 or not self.icloud:
            self.code_error.set_label(t("code_body_any"))
            return
        self.working_status.set_title(t("code_working"))
        self.stack.set_visible_child_name("working")
        self.icloud.code(code)

    # --- Samba ----------------------------------------------------------------------

    def _page_samba(self):
        self.smb_host = self._entry("host")
        self.smb_share = self._entry("share")
        self.smb_user = self._entry("user_optional")
        self.smb_password = self._entry("password_field", password=True)
        self.smb_domain = self._entry("domain")
        page, _, self.smb_error = self._form(
            "samba_title", "samba_body",
            [self.smb_host, self.smb_share, self.smb_user, self.smb_password, self.smb_domain],
            self._samba)
        return page

    def _samba(self):
        host = self.smb_host.get_text().strip().removeprefix("smb://").strip("/")
        if not host:
            self.smb_error.set_label(t("required"))
            return
        self.smb_error.set_label("")
        share = self.smb_share.get_text().strip().strip("/")
        self._working(t("connecting", provider=host))
        options = providers.samba_remote(host, self.smb_user.get_text(),
                                         self.smb_password.get_text(), self.smb_domain.get_text())

        def work():
            cloud.set_setup_remote(options)
            providers.check_remote()
        in_thread(work, lambda _r, error: self._error(error) if error
                  else self._open_folders(host, root=share))

    # --- SFTP -------------------------------------------------------------------------

    def _page_sftp(self):
        self.sftp_host = self._entry("host")
        self.sftp_port = self._entry("port", text="22")
        self.sftp_port.set_input_purpose(Gtk.InputPurpose.DIGITS)
        self.sftp_user = self._entry("user", text=pwd.getpwuid(os.getuid()).pw_name)
        self.sftp_password = self._entry("password_field", password=True)
        self.sftp_use_key = Adw.SwitchRow(title=t("use_key"), subtitle=t("use_key_body"))
        self.sftp_key = Adw.ActionRow(title=t("key_file"), subtitle=t("no_key"))
        self.key_path = next((p for p in (os.path.expanduser(f"~/.ssh/{n}") for n in
                                          ("id_ed25519", "id_ecdsa", "id_rsa"))
                              if os.path.exists(p)), None)
        if self.key_path:
            self.sftp_key.set_subtitle(self.key_path)
        pick = Gtk.Button(label=t("choose_key"), valign=Gtk.Align.CENTER)
        pick.connect("clicked", lambda *_: self._choose_key())
        self.sftp_key.add_suffix(pick)
        self.sftp_passphrase = self._entry("passphrase", password=True)
        for row in (self.sftp_key, self.sftp_passphrase):
            self.sftp_use_key.bind_property("active", row, "visible",
                                            GObject.BindingFlags.SYNC_CREATE)
        self.sftp_use_key.bind_property("active", self.sftp_password, "visible",
                                        GObject.BindingFlags.SYNC_CREATE
                                        | GObject.BindingFlags.INVERT_BOOLEAN)
        page, _, self.sftp_error = self._form(
            "sftp_title", "sftp_body",
            [self.sftp_host, self.sftp_port, self.sftp_user, self.sftp_password,
             self.sftp_use_key, self.sftp_key, self.sftp_passphrase], self._sftp)
        return page

    def _choose_key(self):
        dialog = Gtk.FileDialog(title=t("key_file"), modal=True)
        ssh = os.path.expanduser("~/.ssh")
        if os.path.isdir(ssh):
            dialog.set_initial_folder(Gio.File.new_for_path(ssh))

        def chosen(dialog, result):
            try:
                self.key_path = dialog.open_finish(result).get_path()
                self.sftp_key.set_subtitle(self.key_path)
            except GLib.Error:
                pass
        dialog.open(self, None, chosen)

    def _sftp(self):
        host, user = self.sftp_host.get_text().strip(), self.sftp_user.get_text().strip()
        port = self.sftp_port.get_text().strip() or "22"
        use_key = self.sftp_use_key.get_active()
        if not host or not user or not port.isdigit() or (use_key and not self.key_path):
            self.sftp_error.set_label(t("required"))
            return
        self.sftp_error.set_label("")
        self._working(t("connecting", provider=host))
        options = providers.sftp_remote(
            host, port, user, password=self.sftp_password.get_text(),
            key_file=self.key_path if use_key else None,
            passphrase=self.sftp_passphrase.get_text() if use_key else None)

        def connect():
            def work():
                cloud.set_setup_remote(options)
                providers.check_remote()
            in_thread(work, lambda _r, error: self._error(error) if error
                      else self._open_folders(f"{user}@{host}"))

        def scanned(keys, error):
            if error:
                self._error(error)
                return
            lines, prints = keys
            if providers.host_keys_known(lines):
                connect()
                return
            dialog = Adw.AlertDialog(heading=t("hostkey_title"),
                                     body=t("hostkey_body", host=host, prints="\n".join(prints)),
                                     close_response="cancel")
            dialog.add_response("cancel", t("cancel"))
            dialog.add_response("trust", t("trust"))
            dialog.set_response_appearance("trust", Adw.ResponseAppearance.SUGGESTED)

            def response(_dialog, answer):
                if answer != "trust":
                    self._back()
                    return
                providers.trust_host_keys(lines)
                connect()
            dialog.connect("response", response)
            dialog.present(self)
        in_thread(lambda: providers.host_keys(host, port), scanned)

    # --- the folder -----------------------------------------------------------------

    def _page_folder(self):
        self.folder_group = Adw.PreferencesGroup(title=t("folder_title"))
        new = Gtk.Button(icon_name="folder-new-symbolic", tooltip_text=t("new_folder"),
                         valign=Gtk.Align.CENTER)
        new.add_css_class("flat")
        new.connect("clicked", lambda *_: self._new_folder())
        self.folder_group.set_header_suffix(new)

        self.root = Gio.ListStore.new(Folder)
        tree = Gtk.TreeListModel.new(self.root, False, False, self._children)
        self.selection = Gtk.SingleSelection(model=tree)
        self.selection.connect("notify::selected-item", lambda *_: self._on_folder())
        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", self._setup_row)
        factory.connect("bind", self._bind_row)
        view = Gtk.ListView(model=self.selection, factory=factory)
        view.add_css_class("navigation-sidebar")
        scrolled = Gtk.ScrolledWindow(child=view, min_content_height=280,
                                      hscrollbar_policy=Gtk.PolicyType.NEVER)
        frame = Gtk.Frame(child=scrolled)
        frame.add_css_class("card")
        self.folder_group.add(frame)

        self.destination = Gtk.Label(wrap=True, xalign=0, margin_top=12)
        self.destination.add_css_class("dim-label")
        self.folder_group.add(self.destination)
        self.folder_next = self._button(t("continue"), suggested=True)
        self.folder_next.connect("clicked", lambda *_: self._folder_continue())
        return self._page(self.folder_group, self.folder_next)

    @staticmethod
    def _setup_row(_factory, item):
        box = Gtk.Box(spacing=8)
        box.append(Gtk.Image(icon_name="folder-symbolic"))
        box.append(Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END))
        item.set_child(Gtk.TreeExpander(child=box))

    @staticmethod
    def _bind_row(_factory, item):
        row = item.get_item()
        expander = item.get_child()
        expander.set_list_row(row)
        expander.get_child().get_last_child().set_label(row.get_item().name)

    def _list_dirs(self, path):
        if self.provider == "icloud":
            return providers.icloud_list_dirs(path)
        return providers.list_dirs(path)

    def _make_dir(self, path):
        if self.provider == "icloud":
            providers.icloud_make_dir(path)
        else:
            providers.make_dir(path)

    def _children(self, folder):
        store = Gio.ListStore.new(Folder)
        self.stores[folder.path] = store
        self._list(folder.path, store)
        return store

    def _list(self, path, store):
        def done(names, error):
            if error:
                self._toast(error)
                return
            store.remove_all()
            for name in names:
                store.append(Folder(name, f"{path}/{name}".strip("/")))
        in_thread(lambda: self._list_dirs(path), done)

    def _selected(self):
        row = self.selection.get_selected_item()
        return row.get_item() if row else None

    def _on_folder(self):
        folder = self._selected()
        # Samba: the backups go in a share, not next to the list of shares
        usable = folder is not None and (self.provider != "samba" or folder.path != "")
        self.folder_next.set_sensitive(usable)
        if usable:
            root = self.root.get_item(0)
            shown = f"{root.name}/{folder.path[len(root.path):]}".rstrip("/")
            self.destination.set_label(t("destination", path=shown))
        else:
            self.destination.set_label(t("folder_share") if folder else "")

    def _new_folder(self):
        parent = self._selected() or self.root.get_item(0)
        entry = Gtk.Entry(placeholder_text=t("folder_name"), activates_default=True)
        dialog = Adw.AlertDialog(heading=t("new_folder"), extra_child=entry,
                                 default_response="create", close_response="cancel")
        dialog.add_response("cancel", t("cancel"))
        dialog.add_response("create", t("create"))
        dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)

        def response(_dialog, answer):
            name = entry.get_text().strip().replace("/", "-")
            if answer != "create" or not name:
                return
            path = f"{parent.path}/{name}".strip("/")
            in_thread(lambda: self._make_dir(path),
                      lambda _r, error: self._toast(error) if error else
                      self._list(parent.path, self.stores.get(parent.path)
                                 or Gio.ListStore.new(Folder)))
        dialog.connect("response", response)
        dialog.present(self)

    def _open_folders(self, identity, root=""):
        """Signed in: the tree of the destination's folders, from `root`."""
        if self.provider == "icloud":
            cloud.set_setup_remote(providers.icloud_remote())
        self.identity = identity or ""
        self.stores.clear()
        self.root.remove_all()
        if self.provider == "samba":
            label = f"smb://{self.identity}"
        elif self.provider == "sftp":
            label = f"sftp://{self.identity}"
        elif self.identity:
            label = f"{self._name()} ({self.identity})"
        else:
            label = self._name()
        self.root.append(Folder(f"{label}/{root}" if root else label, root))
        self.folder_group.set_description(t("folder_body"))
        self.selection.set_selected(0)
        self.selection.get_model().get_row(0).set_expanded(True)
        self._on_folder()
        # Back from the folders goes back to the choice of destination
        self.history = ["choose"]
        self.stack.set_visible_child_name("folder")
        self.back.set_visible(True)

    # --- the recovery key -------------------------------------------------------------

    def _key_entry(self, title):
        row = Adw.EntryRow(title=title)
        row.add_css_class("monospace")
        return row

    def _folder_continue(self):
        """The folder is chosen: are there encrypted backups in it already?"""
        self.folder = self._selected()
        self._working(t("looking"))

        def done(candidates, error):
            if error:
                self._error(error)
            elif candidates:
                self.candidates = candidates
                self.unlock_error.set_label("")
                self._show("unlock", remember=False)
            else:
                self._new_backups()
        in_thread(lambda: providers.vault_candidates(self.folder.path,
                                                     self._list_dirs(self.folder.path)), done)

    def _page_unlock(self):
        self.unlock_entry = self._key_entry(t("key_field"))
        other = self._button(t("new_here"))
        other.connect("clicked", lambda *_: self._new_backups())
        page, _, self.unlock_error = self._form("unlock_title", "unlock_body",
                                                [self.unlock_entry], self._unlock, [other])
        return page

    def _unlock(self):
        key = cloud.normalize_key(self.unlock_entry.get_text())
        if not key:
            self.unlock_error.set_label(t("err_key_format"))
            return
        self._working(t("opening"))
        base = {"provider": self.provider, "identity": self.identity,
                "folder": self.folder.path, "vault": True}

        def work():
            for path in self.candidates:
                config = dict(base, repo=path)
                cloud.set_setup_vault(path)
                env = cloud.restic_env(cloud.env(), config, key, remote=cloud.SETUP_REMOTE)
                found = restic(config, env, "cat", "config")
                if found.returncode in (cloud.RESTIC_BAD_PASSWORD, cloud.RESTIC_NO_REPO):
                    continue  # another key's, or not a backup
                if found.returncode != 0:
                    raise RuntimeError(found.stderr.strip() or "restic cat config")
                snapshot = restore.latest(config, env, remote=cloud.SETUP_REMOTE)
                GLib.idle_add(lambda: self.working_status.set_description(t("analysing"))
                              and False)
                plan = snapshot and restore.plan(config, env, snapshot, remote=cloud.SETUP_REMOTE)
                return config, env, snapshot, plan
            return None

        def done(result, error):
            if error:
                self._error(error)
            elif result is None:
                self.unlock_error.set_label(t("err_key"))
                self.stack.set_visible_child_name("unlock")
            else:
                config, env, snapshot, plan = result
                finish = lambda: self._finish_setup(config, key)  # noqa: E731
                if snapshot:
                    # The hourly backups start only afterwards: a backup of
                    # this still empty home folder first would be the newest.
                    self._offer_restore(config, env, cloud.SETUP_REMOTE, snapshot, plan,
                                        after=finish)
                else:
                    finish()
        in_thread(work, done)

    def _new_backups(self):
        self.key = cloud.new_key()
        self._show_key(self.key, new=True)

    def _page_key(self):
        self.key_group = Adw.PreferencesGroup(title=t("key_title"))
        # Not selectable (GTK would select it all on focus): Copy is there
        self.key_label = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER,
                                   margin_top=18, margin_bottom=18)
        self.key_label.add_css_class("title-2")
        self.key_label.add_css_class("monospace")
        self.key_group.add(self.key_label)
        actions = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        for label, icon, handler in ((t("copy"), "edit-copy-symbolic", self._copy_key),
                                     (t("save"), "document-save-symbolic", self._save_key),
                                     (t("print"), "printer-symbolic", self._print_key)):
            button = Gtk.Button(child=Adw.ButtonContent(label=label, icon_name=icon))
            button.add_css_class("pill")
            button.connect("clicked", lambda *_, h=handler: h())
            actions.append(button)
        self.key_saved = Gtk.CheckButton(label=t("key_saved"), halign=Gtk.Align.CENTER)
        self.key_next = self._button(t("continue"), suggested=True)
        self.key_next.connect("clicked", lambda *_: self._key_done())
        self.key_saved.bind_property("active", self.key_next, "sensitive",
                                     GObject.BindingFlags.SYNC_CREATE)
        return self._page(self.key_group, actions, self.key_saved, self.key_next)

    def _show_key(self, key, new):
        self.key, self.key_new = key, new
        groups = cloud.key_groups(key)
        half = len(groups) // 2
        self.key_label.set_label("  ".join(groups[:half]) + "\n" + "  ".join(groups[half:]))
        self.key_group.set_description(t("key_body") if new else t("key_body_view"))
        self.key_saved.set_visible(new)
        self.key_saved.set_active(not new)
        self.key_next.set_label(t("continue") if new else t("close"))
        self._show("key")

    def _key_done(self):
        if not self.key_new:
            self._show("status", remember=False)
            self.history.clear()
            return
        # Retyping two groups, so that the key is really kept somewhere
        import random
        self.verify_groups = sorted(random.sample(range(cloud.KEY_GROUPS), 2))
        for row, index in zip(self.verify_rows, self.verify_groups):
            row.set_title(t("group", n=index + 1))
            row.set_text("")
        self.verify_error.set_label("")
        self._show("verify")

    def _page_verify(self):
        self.verify_rows = [self._key_entry(""), self._key_entry("")]
        page, _, self.verify_error = self._form("verify_title", "verify_body", self.verify_rows,
                                                self._verify)
        return page

    def _verify(self):
        groups = cloud.key_groups(self.key)
        typed = [cloud.normalize_group(row.get_text()) for row in self.verify_rows]
        if typed != [groups[i] for i in self.verify_groups]:
            self.verify_error.set_label(t("err_groups"))
            return
        self._create()

    def _key_text(self):
        when = GLib.DateTime.new_now_local().format("%x")
        return t("key_document", key=self.key, date=when, where=self._where())

    def _where(self):
        config = cloud.load_config() if not self.key_new else None
        provider = config["provider"] if config else self.provider
        return cloud.PROVIDERS.get(provider, "")

    def _copy_key(self):
        self.get_clipboard().set(self.key)
        self._toast(t("copied"))

    def _save_key(self):
        dialog = Gtk.FileDialog(title=t("save"), initial_name=t("key_file_name"), modal=True)

        def saved(dialog, result):
            try:
                path = dialog.save_finish(result).get_path()
            except GLib.Error:
                return
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(self._key_text())
            self._toast(t("saved_to", path=path))
        dialog.save(self, None, saved)

    def _print_key(self):
        text = self._key_text()
        operation = Gtk.PrintOperation(n_pages=1, job_name=t("key_file_name"))

        def draw(operation, context, _page):
            layout = context.create_pango_layout()
            layout.set_width(int(context.get_width() * Pango.SCALE))
            layout.set_wrap(Pango.WrapMode.WORD)
            layout.set_font_description(Pango.FontDescription.from_string("Sans 12"))
            layout.set_text(text, -1)
            PangoCairo.show_layout(context.get_cairo_context(), layout)
        operation.connect("draw-page", draw)
        operation.run(Gtk.PrintOperationAction.PRINT_DIALOG, self)

    def _create(self):
        """New backups: an encrypted folder with a neutral name in the folder."""
        vault = f"{self.folder.path}/{cloud.new_vault_name()}".strip("/")
        config = {"provider": self.provider, "identity": self.identity,
                  "folder": self.folder.path, "repo": vault, "vault": True}
        key = self.key
        self._working(t("working_title"), t("working_body"))

        def work():
            cloud.set_setup_vault(vault)
            env = cloud.restic_env(cloud.env(), config, key, remote=cloud.SETUP_REMOTE)
            created = restic(config, env, "init")
            if created.returncode != 0:
                raise RuntimeError(created.stderr.strip() or "restic init")
        in_thread(work, lambda _r, error: self._error(error) if error
                  else self._finish_setup(config, key))

    def _page_working(self):
        self.working_status = Adw.StatusPage(vexpand=True)
        self.working_status.set_child(Adw.Spinner(width_request=48, height_request=48))
        return self.working_status

    def _page_error(self):
        self.error_status = Adw.StatusPage(icon_name="dialog-warning-symbolic", vexpand=True,
                                           title=t("error_title"))
        back = self._button(t("back"))
        back.connect("clicked", lambda *_: self._back())
        self.error_status.set_child(back)
        return self.error_status

    def _error(self, message):
        self.waiting = False
        self.error_status.set_description(GLib.markup_escape_text(str(message)))
        self.stack.set_visible_child_name("error")
        self.back.set_visible(bool(self.history))

    def _finish_setup(self, config, key):
        self._working(t("working_title"), t("working_body"))

        def work():
            cloud.promote_setup_remote()
            cloud.store_key(config["repo"], key)
            cloud.save_config(config)
            for args in (("daemon-reload",), ("enable", "--now", "live-backup.timer"),
                         ("start", "--no-block", "live-backup.service")):
                result = systemctl(*args)
                if result.returncode != 0:
                    raise RuntimeError(result.stderr.strip())
            # The cloud in Files too; the backups work without it
            try:
                return mount.set_up(config), None
            except Exception as e:  # noqa: BLE001
                return None, str(e)

        def done(result, error):
            if error:
                self._error(error)
                return
            path, problem = result
            self.done_status.set_description(
                t("done_body") + ("\n\n" + t("done_files", name=os.path.basename(path))
                                   if path else ""))
            if problem:
                self._toast(t("mount_failed", reason=problem))
            if os.path.exists(AUTOSTART):
                os.remove(AUTOSTART)
            self.unlock_entry.set_text("")
            self.history.clear()
            self._show("done", remember=False)
        in_thread(work, done)

    # --- restore ----------------------------------------------------------------------

    def _page_restore(self):
        self.restore_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        restore_button = self._button(t("restore_do"), suggested=True)
        restore_button.connect("clicked", lambda *_: self._restore())
        later = self._button(t("restore_skip"))
        later.connect("clicked", lambda *_: self.restore_after())
        buttons = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        buttons.append(restore_button)
        buttons.append(later)
        return self._page(self.restore_box, buttons)

    @staticmethod
    def _count_row(title, icon, count):
        row = Adw.ActionRow(title=title)
        row.add_prefix(Gtk.Image(icon_name=icon))
        label = Gtk.Label(label=f"{count:n}")
        label.add_css_class("dim-label")
        label.add_css_class("numeric")
        row.add_suffix(label)
        return row

    def _offer_restore(self, config, env, remote, snapshot, plan, after):
        """The restore page: what comes back, what it replaces."""
        self.restore_job = (config, env, remote, snapshot)
        self.restore_after = after
        while child := self.restore_box.get_first_child():
            self.restore_box.remove(child)
        when = snapshot["time"].astimezone().strftime("%x %H:%M")
        intro = Adw.PreferencesGroup(
            title=t("restore_title"),
            description=t("restore_body", when=when, host=snapshot["hostname"],
                          files=f"{plan['files']:n}", size=GLib.format_size(plan["bytes"])))
        self.restore_box.append(intro)
        back = Adw.PreferencesGroup(title=t("restore_what"))
        for kind, icon in restore.KIND_ICONS.items():
            if plan["restore"].get(kind):
                back.add(self._count_row(t(f"kind_{kind}"), icon, plan["restore"][kind]))
        self.restore_box.append(back)
        if plan["replace"]:
            replaced = Adw.PreferencesGroup(title=t("replace_what"), description=t("replace_body"))
            for kind, icon in restore.REPLACED_ICONS.items():
                if plan["replace"].get(kind):
                    replaced.add(self._count_row(t(f"rep_{kind}"), icon, plan["replace"][kind]))
            self.restore_box.append(replaced)
        self._show("restore")

    def _page_restoring(self):
        self.restoring = Adw.StatusPage(icon_name="folder-download-symbolic", vexpand=True,
                                        title=t("restoring_title"),
                                        description=t("restoring_body"))
        self.progress = Gtk.ProgressBar(show_text=True, width_request=320,
                                        halign=Gtk.Align.CENTER)
        self.restoring.set_child(self.progress)
        return self.restoring

    def _restore(self):
        config, env, remote, snapshot = self.restore_job
        self.progress.set_fraction(0)
        self._show("restoring")
        self.back.set_visible(False)

        def progress(fraction):
            GLib.idle_add(lambda: self.progress.set_fraction(min(fraction, 1)) and False)

        def done(problems, error):
            if error:
                self._error(error)
                return
            body = t("restored_body")
            if problems:
                body += "\n\n" + t("restored_problems") + "\n" + "\n".join(
                    t(f"problem_{p}") for p in problems)
            self.restored.set_description(GLib.markup_escape_text(body))
            self._show("restored")
            self.back.set_visible(False)
        in_thread(lambda: restore.restore(config, env, snapshot, progress, remote=remote), done)

    def _page_restored(self):
        self.restored = Adw.StatusPage(icon_name="object-select-symbolic", vexpand=True,
                                       title=t("restored_title"))
        go = self._button(t("continue"), suggested=True)
        go.connect("clicked", lambda *_: self.restore_after())
        self.restored.set_child(go)
        return self.restored

    def _restore_from_status(self):
        """Restore, from the status page: the configured backups' newest."""
        config = cloud.load_config()
        if not config:
            return
        self._working(t("analysing"))

        def work():
            key = cloud.lookup_key(config["repo"])
            if not key:
                raise RuntimeError(t("no_password"))
            if config["provider"] == "icloud":
                providers.icloud_start()
            env = cloud.restic_env(cloud.env(), config, key)
            snapshot = restore.latest(config, env)
            return (env, snapshot, snapshot and restore.plan(config, env, snapshot))

        def done(result, error):
            if error:
                self._error(error)
                return
            env, snapshot, plan = result
            if snapshot is None:
                self._show("status", remember=False)
                self._toast(t("no_backup_yet"))
                return
            self._offer_restore(config, env, cloud.REMOTE, snapshot, plan,
                                after=lambda: self._show("status", remember=False))
        in_thread(work, done)

    def _page_done(self):
        self.done_status = status = Adw.StatusPage(
            icon_name="object-select-symbolic", title=t("done_title"),
            description=t("done_body"), vexpand=True)
        close = self._button(t("close"), suggested=True)
        close.connect("clicked", lambda *_: self.close())
        status.set_child(close)
        return status

    # --- status ---------------------------------------------------------------------

    def _page_status(self):
        group = Adw.PreferencesGroup(title=t("status_title"))
        self.status_rows = {}
        for key in ("where", "folder", "last"):
            row = Adw.ActionRow(title=t(key), subtitle_selectable=True)
            row.add_css_class("property")
            group.add(row)
            self.status_rows[key] = row
        now = self._button(t("backup_now"), suggested=True)
        now.connect("clicked", lambda *_: self._backup_now())
        back = self._button(t("restore_from"))
        back.connect("clicked", lambda *_: self._restore_from_status())
        show_key = self._button(t("show_key"))
        show_key.connect("clicked", lambda *_: self._key_from_status())
        self.open_files = self._button(t("open_files"))
        self.open_files.connect("clicked", lambda *_: self._open_in_files())
        change = self._button(t("change"))
        change.connect("clicked", lambda *_: self._show("choose"))
        stop = self._button(t("stop"), destructive=True)
        stop.connect("clicked", lambda *_: self._stop())
        buttons = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for button in (now, self.open_files, back, show_key, change, stop):
            buttons.append(button)
        return self._page(group, buttons)

    def _open_in_files(self):
        current = mount._current()
        if current and current[0]:
            Gtk.FileLauncher.new(Gio.File.new_for_path(current[0])).launch(self, None, None, None)

    def _key_from_status(self):
        config = cloud.load_config()
        key = config and cloud.lookup_key(config["repo"])
        if not key:
            self._toast(t("no_password"))
            return
        self._show_key(key, new=False)

    def _refresh_status(self):
        config = cloud.load_config()
        if not config:
            return False
        self.open_files.set_visible(bool(mount._current()))
        name, identity = cloud.PROVIDERS.get(config["provider"], ""), config.get("identity")
        where = f"{name} ({identity})" if identity else name
        self.status_rows["where"].set_subtitle(GLib.markup_escape_text(where))
        self.status_rows["folder"].set_subtitle(GLib.markup_escape_text(config["repo"]))
        active = systemctl("is-active", "live-backup.service").stdout.strip() == "activating"
        status = cloud.load_status()
        if active:
            last = t("running")
        elif not status or "time" not in status:
            last = t("never")
        else:
            when = GLib.DateTime.new_from_iso8601(status["time"], None)
            when = when.to_local().format("%x %X") if when else status["time"]
            last = f"{when} — {t('ok') if status.get('ok') else status.get('message', '')}"
        self.status_rows["last"].set_subtitle(GLib.markup_escape_text(last))
        if not hasattr(self, "_status_timer"):
            self._status_timer = GLib.timeout_add_seconds(5, self._refresh_status)
        return True

    def _backup_now(self):
        systemctl("start", "--no-block", "live-backup.service")
        GLib.timeout_add(500, lambda: self._refresh_status() and False)

    def _stop(self):
        dialog = Adw.AlertDialog(heading=t("stop_confirm"), body=t("stop_body"),
                                 close_response="cancel")
        dialog.add_response("cancel", t("cancel"))
        dialog.add_response("stop", t("stop"))
        dialog.set_response_appearance("stop", Adw.ResponseAppearance.DESTRUCTIVE)

        def response(_dialog, answer):
            if answer == "stop":
                systemctl("disable", "--now", "live-backup.timer")
                mount.remove()
                if os.path.exists(cloud.CONFIG):
                    os.remove(cloud.CONFIG)
                self.history.clear()
                self._show("choose", remember=False)
        dialog.connect("response", response)
        dialog.present(self)


class BackupApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.first_run = False

    def do_command_line(self, command_line):
        self.first_run = "--first-run" in command_line.get_arguments()[1:]
        self.activate()
        return 0

    def do_activate(self):
        window = self.get_active_window()
        if window is None:
            # First run with the backups already set up: nothing to ask.
            if self.first_run and cloud.load_config():
                return
            window = BackupWindow(self, self.first_run)
        window.present()


if __name__ == "__main__":
    sys.exit(BackupApp().run(sys.argv))
