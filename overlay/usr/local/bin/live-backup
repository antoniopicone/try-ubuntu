#!/usr/bin/python3
"""live-backup: the Backup app. Sets up, and then shows, the encrypted
backups of the home folder (restic, see /usr/local/lib/live-backup).

At the first login of the user live-welcome created it starts by itself
(--first-run, ~/.config/autostart) and asks where to keep the backups: a
folder on Nextcloud or OneDrive, through a GNOME Online Accounts account
(an existing one, or one added in Settings' own dialog, so it's in Settings
too), or on Google Drive or Dropbox, signed in in the browser with rclone
(Ubuntu's GOA has neither). Then the folder, picked in a tree of the
account's folders,
and the user's password, which encrypts the backups on this computer before
they leave it (restic). iCloud, Samba and SFTP are listed, not there yet.
"Later" skips it all: the app stays in the app grid.

Once set up it shows the last backup and can start one, change the folder
or stop the backups.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, GObject, Gtk, Pango  # noqa: E402

sys.path.insert(0, "/usr/local/lib/live-backup")
import cloud  # noqa: E402

APP_ID = "org.ubuntu.LiveBackup"
AUTOSTART = os.path.expanduser(f"~/.config/autostart/{APP_ID}.desktop")
CHKPWD = "/usr/sbin/unix_chkpwd"

# id, icon, title key, body key, available
DESTINATIONS = [
    ("google", "goa-account-google", "dest_google", "dest_google_body", True),
    ("ms_graph", "goa-account-ms365", "dest_onedrive", "dest_onedrive_body", True),
    ("dropbox", "folder-remote", "dest_dropbox", "dest_dropbox_body", True),
    ("owncloud", "goa-account-owncloud", "dest_nextcloud", "dest_nextcloud_body", True),
    ("icloud", "weather-overcast-symbolic", "dest_icloud", "soon", False),
    ("samba", "network-server-symbolic", "dest_samba", "soon", False),
    ("sftp", "utilities-terminal-symbolic", "dest_sftp", "soon", False),
]

