+/* The FUSE mounts of the clouds (nautilus_mount_is_cloud) get a cloud, and the
+ * Tailscale network's a VPN: gvfs gives every mount without a volume a
+ * removable drive. rclone's other mounts (Samba, SFTP) get a network folder. */
+static GIcon *
+get_mount_symbolic_icon (GMount *mount,
+                         GFile  *root)
+{
+    g_autofree char *path = g_file_get_path (root);
+    g_autoptr (GUnixMountEntry) entry = NULL;
+    const char *fs_type = NULL;
+
+    if (path != NULL)
+    {
+        entry = g_unix_mount_entry_at (path, NULL);
+    }
+    if (entry != NULL)
+    {
+        fs_type = g_unix_mount_entry_get_fs_type (entry);
+    }
+    if (g_strcmp0 (fs_type, "fuse.tailnet") == 0)
+    {
+        return g_themed_icon_new ("network-vpn-symbolic");
+    }
+    if (nautilus_mount_is_cloud (mount))
+    {
+        return g_themed_icon_new ("live-cloud-symbolic");
+    }
+    if (g_strcmp0 (fs_type, "fuse.rclone") == 0)
+    {
+        return g_themed_icon_new ("folder-remote-symbolic");
+    }
+
+    return g_mount_get_symbolic_icon (mount);
+}
