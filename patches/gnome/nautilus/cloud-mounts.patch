From: Live ISO builder <live@localhost>
Subject: The clouds' and the tailnet's FUSE mounts: their icon, and no unmounting

gvfs gives every mount without a volume, as FUSE mounts in the home folder
are, the symbolic icon of a removable drive, and Files offers to unmount
it. The clouds that Cloud Config mounts with rclone (device
"live-cloud:<id>") and icloud-linux's iCloud Drive (fuse.icloud) get
live-cloud-symbolic instead, rclone's other mounts (Samba, SFTP)
folder-remote-symbolic, and live-tailnet's devices of the Tailscale network
(fuse.tailnet) network-vpn-symbolic.

The clouds and the Tailscale network can't be unmounted from Files either
(the sidebar's button and menu, the views' menu): their services mount them
at every login, and an unmounted iCloud Drive stops syncing without a word.
---
--- a/src/nautilus-file-utilities.c
+++ b/src/nautilus-file-utilities.c
@@ -39,6 +39,7 @@
 #include <glib/gi18n.h>
 #include <glib/gstdio.h>
 #include <gio/gio.h>
+#include <gio/gunixmounts.h>
 #include <unistd.h>
 #include <stdlib.h>
 #include <sys/vfs.h>
@@ -337,6 +338,43 @@ nautilus_get_mounted_mount_for_root (GFile *location)
     return result;
 }
 
+/* Is it the FUSE mount of a cloud: one that Cloud Config mounts with rclone
+ * (device "live-cloud:<id>"), icloud-linux's iCloud Drive, or live-tailnet's
+ * devices of the Tailscale network? They belong to their services, which
+ * mount them at every login: Files shows them with their own icon, and
+ * doesn't offer to unmount them. */
+gboolean
+nautilus_mount_is_cloud (GMount *mount)
+{
+    g_autoptr (GFile) root = NULL;
+    g_autofree char *path = NULL;
+    g_autoptr (GUnixMountEntry) entry = NULL;
+    const char *fs_type;
+
+    if (mount == NULL)
+    {
+        return FALSE;
+    }
+
+    root = g_mount_get_root (mount);
+    path = g_file_get_path (root);
+    if (path != NULL)
+    {
+        entry = g_unix_mount_entry_at (path, NULL);
+    }
+    if (entry == NULL)
+    {
+        return FALSE;
+    }
+
+    fs_type = g_unix_mount_entry_get_fs_type (entry);
+
+    return g_strcmp0 (fs_type, "fuse.icloud") == 0 ||
+           g_strcmp0 (fs_type, "fuse.tailnet") == 0 ||
+           (g_strcmp0 (fs_type, "fuse.rclone") == 0 &&
+            g_str_has_prefix (g_unix_mount_entry_get_device_path (entry), "live-cloud:"));
+}
+
 GFile *
