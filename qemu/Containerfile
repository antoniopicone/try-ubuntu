# Builder image for QEMU on Linux (see build-linux.sh). Ubuntu 22.04, so
# that what it builds runs on glibc 2.35 or newer: its GTK 3, PulseAudio and
# ALSA are the ones QEMU is linked against, and those of the computer it
# runs on are used. tomli is for QEMU's venv (Python older than 3.11).
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config ninja-build patchelf bzip2 xz-utils \
      python3 python3-venv python3-tomli \
      libglib2.0-dev libpixman-1-dev zlib1g-dev \
      libgtk-3-dev libepoxy-dev libegl-dev libgbm-dev libdrm-dev \
      libpulse-dev libasound2-dev \
    && rm -rf /var/lib/apt/lists/*
